<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BoardgameTracker.App.Games.ArkNova.Features.GameSessions.Scoring.ArkNovaPlayerScoringPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:BoardgameTracker.App.Games.ArkNova.Features.GameSessions.Scoring"
    x:DataType="vm:ArkNovaPlayerScoringViewModel"
    Shell.NavBarIsVisible="False">
    <Grid Padding="18" RowDefinitions="Auto,*,Auto" RowSpacing="18">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <ImageButton Clicked="OnDoneClicked" Source="icon_back.png" Style="{StaticResource IconButton}" />
            <Label Grid.Column="1" Text="{Binding Name}" FontAttributes="Bold" FontSize="23" VerticalOptions="Center" />
        </Grid>
        <VerticalStackLayout Grid.Row="1" Spacing="16">
            <VerticalStackLayout Spacing="4">
                <Label Text="Attraktivität" FontAttributes="Bold" />
                <Grid ColumnDefinitions="*,Auto">
                    <Entry Text="{Binding AttractivenessText}" Keyboard="Numeric" MaxLength="3" Placeholder="0–113" />
                    <Label Grid.Column="1" Text="0–113" Margin="10,0,0,0" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}" />
                </Grid>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="4">
                <Label Text="Artenschutz" FontAttributes="Bold" />
                <Grid ColumnDefinitions="*,Auto">
                    <Entry Text="{Binding ConservationText}" Keyboard="Numeric" MaxLength="2" Placeholder="0–41" />
                    <Label Grid.Column="1" Text="0–41" Margin="10,0,0,0" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}" />
                </Grid>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="4" IsVisible="{Binding IsReputationVisible}">
                <Label Text="Ruf" FontAttributes="Bold" />
                <Grid ColumnDefinitions="*,Auto">
                    <Entry Text="{Binding ReputationText}" Keyboard="Numeric" MaxLength="2" Placeholder="optional" />
                    <Label Grid.Column="1" Text="optional · 1–15" Margin="10,0,0,0" VerticalOptions="Center" TextColor="{StaticResource TextSecondary}" />
                </Grid>
            </VerticalStackLayout>
            <Border Padding="14" Style="{StaticResource CardBorder}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Berechnete Punkte" />
                    <Label Grid.Column="1" Text="{Binding ScoreText}" FontAttributes="Bold" FontSize="20" />
                </Grid>
            </Border>
            <Label Text="{Binding ValidationMessage}" TextColor="{StaticResource Danger}" FontSize="12" />
        </VerticalStackLayout>
        <Button Grid.Row="2" Text="Fertig" Style="{StaticResource PrimaryCompactButton}" Clicked="OnDoneClicked" />
    </Grid>
</ContentPage>
