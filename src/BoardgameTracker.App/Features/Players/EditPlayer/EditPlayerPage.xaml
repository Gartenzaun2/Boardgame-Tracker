<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BoardgameTracker.App.Features.Players.EditPlayer" xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization"
    x:Class="BoardgameTracker.App.Features.Players.EditPlayer.EditPlayerPage" x:DataType="local:EditPlayerViewModel" Shell.NavBarIsVisible="False">
    <Grid Padding="18" RowDefinitions="Auto,*,Auto" RowSpacing="12" x:Name="EditorContent">
        <VerticalStackLayout Spacing="8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <ImageButton Source="icon_back.png" Style="{StaticResource IconButton}" Clicked="OnBackClicked" SemanticProperties.Description="{x:Static res:AppResources.Back}" />
                <Label Grid.Column="1" Text="{x:Static res:AppResources.EditPlayer}" FontSize="24" FontAttributes="Bold" VerticalOptions="Center" />
            </Grid>
            <BoxView Style="{StaticResource HeaderDivider}" />
        </VerticalStackLayout>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12" IsEnabled="{Binding IsIdle}">
                <Label Text="{x:Static res:AppResources.PlayerNameLabel}" FontAttributes="Bold" />
                <Entry Text="{Binding Name}" Style="{StaticResource InlineFormEntry}" />
                <HorizontalStackLayout Spacing="8">
                    <Label Text="{x:Static res:AppResources.Archived}" VerticalOptions="Center" />
                    <Switch IsToggled="{Binding IsArchived}" />
                </HorizontalStackLayout>
                <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{DynamicResource Danger}" />
            </VerticalStackLayout>
        </ScrollView>
        <Button Grid.Row="2" Text="{x:Static res:AppResources.Save}" Clicked="OnSaveClicked" Style="{StaticResource PrimaryCompactButton}" IsEnabled="{Binding IsIdle}" />
    </Grid>
</ContentPage>
