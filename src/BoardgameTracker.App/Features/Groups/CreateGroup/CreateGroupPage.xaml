<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BoardgameTracker.App.Features.Groups.CreateGroup.CreateGroupPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <Grid
            Padding="12,10"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="10">
            <Button
                BackgroundColor="Transparent"
                Clicked="OnBackClicked"
                FontSize="24"
                HeightRequest="44"
                Text="←"
                WidthRequest="44" />

            <HorizontalStackLayout
                Grid.Column="1"
                Spacing="6"
                VerticalOptions="Center">
                <Label
                    FontAttributes="Bold"
                    FontSize="22"
                    Text="{x:Static res:AppResources.CreateGroup}"
                    VerticalOptions="Center" />
                <Button
                    BackgroundColor="Transparent"
                    Clicked="OnInfoClicked"
                    FontSize="18"
                    HeightRequest="40"
                    Padding="6,0"
                    Text="ⓘ"
                    ToolTipProperties.Text="{x:Static res:AppResources.CreateGroupHint}"
                    WidthRequest="40" />
            </HorizontalStackLayout>

            <Button
                Grid.Column="2"
                BackgroundColor="#2E6F40"
                Command="{Binding SaveCommand}"
                FontAttributes="Bold"
                Text="{x:Static res:AppResources.Save}"
                TextColor="White" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24,16,24,28" Spacing="22">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <Label
                        FontAttributes="Bold"
                        Text="{x:Static res:AppResources.GroupName}"
                        VerticalOptions="Center" />
                    <Entry
                        Grid.Column="1"
                        Placeholder="{x:Static res:AppResources.GroupNamePlaceholder}"
                        Text="{Binding GroupName}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <Label
                        Text="{x:Static res:AppResources.TemporaryGroup}"
                        VerticalOptions="Center" />
                    <Switch
                        Grid.Column="1"
                        IsToggled="{Binding IsTemporary}" />
                </Grid>

                <VerticalStackLayout Spacing="10">
                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="{x:Static res:AppResources.GroupMembers}" />
                    <Label
                        FontSize="13"
                        Text="{x:Static res:AppResources.DefaultOrderHint}" />

                    <Label
                        IsVisible="{Binding HasNoMembers}"
                        Text="{x:Static res:AppResources.NoMembersYet}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Members}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,4"
                                    Padding="12"
                                    Stroke="#D7DBD3"
                                    StrokeShape="RoundRectangle 12">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="2">
                                            <Label FontAttributes="Bold" Text="{Binding Name}" />
                                            <Label
                                                FontSize="12"
                                                IsVisible="{Binding IsGuest}"
                                                Text="{x:Static res:AppResources.Guest}" />
                                        </VerticalStackLayout>
                                        <Button
                                            Grid.Column="1"
                                            Command="{Binding Source={x:Reference Page}, Path=BindingContext.MoveMemberUpCommand}"
                                            CommandParameter="{Binding .}"
                                            Text="↑" />
                                        <Button
                                            Grid.Column="2"
                                            Command="{Binding Source={x:Reference Page}, Path=BindingContext.MoveMemberDownCommand}"
                                            CommandParameter="{Binding .}"
                                            Text="↓" />
                                        <Button
                                            Grid.Column="3"
                                            Command="{Binding Source={x:Reference Page}, Path=BindingContext.RemoveMemberCommand}"
                                            CommandParameter="{Binding .}"
                                            Text="×" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Border
                    Padding="16"
                    Stroke="#D7DBD3"
                    StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="{x:Static res:AppResources.AddExistingPerson}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Picker
                                ItemDisplayBinding="{Binding Name}"
                                ItemsSource="{Binding AvailablePersons}"
                                SelectedItem="{Binding SelectedExistingPerson}"
                                Title="{x:Static res:AppResources.SelectPerson}" />
                            <Button
                                Grid.Column="1"
                                Command="{Binding AddSelectedPersonCommand}"
                                Text="+" />
                        </Grid>
                        <Label
                            FontSize="12"
                            IsVisible="{Binding HasNoAvailablePersons}"
                            Text="{x:Static res:AppResources.NoAvailablePersons}" />
                    </VerticalStackLayout>
                </Border>

                <Border
                    Padding="16"
                    Stroke="#D7DBD3"
                    StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="{x:Static res:AppResources.NewPerson}" />
                        <Entry
                            Placeholder="{x:Static res:AppResources.PersonNamePlaceholder}"
                            Text="{Binding NewPersonName}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label
                                Text="{x:Static res:AppResources.Guest}"
                                VerticalOptions="Center" />
                            <Switch
                                Grid.Column="1"
                                IsToggled="{Binding NewPersonIsGuest}" />
                        </Grid>
                        <Button
                            Command="{Binding AddNewPersonCommand}"
                            HorizontalOptions="End"
                            Text="{x:Static res:AppResources.AddPerson}" />
                    </VerticalStackLayout>
                </Border>

                <Label
                    Text="{Binding ErrorMessage}"
                    TextColor="#B3261E" />

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
