<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BoardgameTracker.App.Features.Games.ListGames.GamesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization"
    Shell.NavBarIsVisible="False">
    <Grid Padding="20,22" RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <Label Text="{x:Static res:AppResources.Games}" FontAttributes="Bold" FontSize="28" />
        <Label Grid.Row="1" Text="{x:Static res:AppResources.GameCatalogHint}" TextColor="{StaticResource TextSecondary}" />
        <Border Grid.Row="2" Padding="18" Style="{StaticResource CardBorder}" VerticalOptions="Start">
            <VerticalStackLayout Spacing="5">
                <Label Text="{x:Static res:AppResources.ArkNova}" FontAttributes="Bold" FontSize="20" />
                <Label Text="{x:Static res:AppResources.SupportedGame}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
