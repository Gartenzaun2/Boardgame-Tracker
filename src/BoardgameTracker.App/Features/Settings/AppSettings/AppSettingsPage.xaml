<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BoardgameTracker.App.Features.Settings.AppSettings.AppSettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization"
    Shell.NavBarIsVisible="False">
    <Grid Padding="20,22" RowDefinitions="Auto,*" RowSpacing="14">
        <VerticalStackLayout Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Text="{x:Static res:AppResources.AppSettingsTitle}" FontAttributes="Bold" FontSize="28" VerticalOptions="Center" />
                <ImageButton Grid.Column="1" Clicked="OnInfoClicked" Source="icon_info.png" Style="{StaticResource IconButton}"
                             SemanticProperties.Description="{x:Static res:AppResources.GameSettingsHint}"
                             ToolTipProperties.Text="{x:Static res:AppResources.GameSettingsHint}" />
            </Grid>
            <BoxView Style="{StaticResource HeaderDivider}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
        <VerticalStackLayout Spacing="12">
            <Border Padding="16" Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{x:Static res:AppResources.AppearanceTheme}" FontAttributes="Bold" />
                    <Button x:Name="ThemeChoice" Clicked="OnThemeClicked" Style="{StaticResource SecondaryActionButton}" SemanticProperties.Description="{x:Static res:AppResources.AppearanceTheme}" />
                </VerticalStackLayout>
            </Border>
            <Border Padding="16" Style="{StaticResource CardBorder}">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{x:Static res:AppResources.DefaultGame}" FontAttributes="Bold" FontSize="17" VerticalOptions="Center" />
                        <ImageButton Grid.Column="1" Clicked="OnDefaultGameInfoClicked" Source="icon_info.png" Style="{StaticResource IconButton}"
                                     SemanticProperties.Description="{x:Static res:AppResources.DefaultGameHint}"
                                     ToolTipProperties.Text="{x:Static res:AppResources.DefaultGameHint}" />
                    </Grid>
                    <Button x:Name="DefaultGameChoice" Grid.Row="1" Clicked="OnDefaultGameClicked" Style="{StaticResource SecondaryActionButton}" SemanticProperties.Description="{x:Static res:AppResources.DefaultGame}" />
                </Grid>
            </Border>

            <Border Padding="16" Style="{StaticResource CardBorder}">
                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPlayersTapped" /></Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{x:Static res:AppResources.Players}" FontAttributes="Bold" FontSize="18" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="›" FontSize="26" VerticalOptions="Center" />
                </Grid>
            </Border>
            <Border Padding="16" Style="{StaticResource CardBorder}" VerticalOptions="Start">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnArkNovaSettingsTapped" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="{x:Static res:AppResources.ArkNova}" FontAttributes="Bold" FontSize="18" />
                        <Label Text="{x:Static res:AppResources.GameSettings}" FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="1" Text="›" FontSize="26" VerticalOptions="Center" />
                </Grid>
            </Border>
        </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
