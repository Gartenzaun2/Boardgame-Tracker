<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:presentation="clr-namespace:BoardgameTracker.App.Presentation" xmlns:header="clr-namespace:BoardgameTracker.App.Presentation.Controls" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BoardgameTracker.App.Features.Groups.ListGroups" xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization"
    x:Name="Page" x:Class="BoardgameTracker.App.Features.Groups.ListGroups.GroupListPage" x:DataType="local:GroupListViewModel" Shell.NavBarIsVisible="False">
    <Grid>
        <Grid RowDefinitions="Auto,*" RowSpacing="12" IsEnabled="{Binding CanInteract}">
            <VerticalStackLayout Spacing="8">

                <!-- Page header: return and selected game context. -->
                <header:AppPageHeader x:Name="PageHeader" Title="{x:Static res:AppResources.Groups}" Variant="Subpage" BackCommand="{Binding GoBackCommand}" GameName="{Binding SelectedGameName}" BadgeText="{Binding BadgeText}" />
            </VerticalStackLayout>
            <Grid Grid.Row="1" Padding="18,0,18,18" RowDefinitions="*,Auto,Auto" RowSpacing="12">

                <!-- Assigned groups: resume an open game session or open preparation. -->
                <CollectionView Grid.Row="0" ItemsSource="{Binding Groups}" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="local:GroupListItemViewModel">
                            <Border Style="{StaticResource CardBorder}" Padding="12">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=ViewModel.OpenGroupCommand, x:DataType=local:GroupListPage}" CommandParameter="{Binding Id}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MinimumHeightRequest="44">
                                    <VerticalStackLayout Spacing="4">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                                            <Image Source="icon_active_session.png" presentation:IconTint.Color="{DynamicResource TextPrimary}" HeightRequest="20" WidthRequest="20" IsVisible="{Binding HasOpenGameSession}" SemanticProperties.Description="{x:Static res:AppResources.OpenGameSession}" />
                                        </HorizontalStackLayout>
                                        <Label Text="{Binding PlayerNames}" />
                                        <Label Text="{Binding LastPlayedText}" IsVisible="{Binding HasLastPlayed}" FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                                    </VerticalStackLayout>
                                    <Image Grid.Column="1" Source="icon_chevron.png" Style="{StaticResource NavigationChevron}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Status and group-creation or assignment actions. -->
                <VerticalStackLayout Grid.Row="1" Spacing="8">
                    <Label Text="{Binding EmptyMessage}" IsVisible="{Binding IsEmpty}" />
                    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{DynamicResource Danger}" />
                </VerticalStackLayout>
                <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Text="{x:Static res:AppResources.NewGroup}" Command="{Binding CreateGroupCommand}" IsEnabled="{Binding CanCreate}" Style="{StaticResource SecondaryActionButton}" />
                    <Button Grid.Column="1" Text="{x:Static res:AppResources.ChooseExistingGroup}" Command="{Binding ChooseExistingCommand}" IsEnabled="{Binding CanChoose}" Style="{StaticResource PrimaryCompactButton}" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Existing group selection overlay: assign an eligible group to this game. -->
        <Grid IsVisible="{Binding IsChoosingExisting}" BackgroundColor="{DynamicResource ModalOverlay}" Padding="18">
            <Border Style="{StaticResource SelectionDialog}">
                <Grid RowDefinitions="Auto,*" RowSpacing="12" MaximumHeightRequest="450">
                    <Grid ColumnDefinitions="Auto,*">
                        <ImageButton Source="icon_back.png" Style="{StaticResource IconButton}"
                            Command="{Binding CloseSelectionCommand}"
                            SemanticProperties.Description="{x:Static res:AppResources.Back}" />
                        <Label Grid.Column="1" Text="{x:Static res:AppResources.ChooseExistingGroup}" FontSize="19" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <CollectionView Grid.Row="1" ItemsSource="{Binding AvailableGroups}" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="local:AvailablePlayGroup">
                                <Border Style="{StaticResource CardBorder}" Padding="12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=ViewModel.SelectExistingCommand, x:DataType=local:GroupListPage}" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" />
                                        <Label Text="{Binding Members}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>

        <!-- Busy overlay: cover page and selection while loading or navigating. -->
        <Grid IsVisible="{Binding IsWorking}" BackgroundColor="{DynamicResource BusyOverlay}">
            <ActivityIndicator IsRunning="{Binding IsWorking}" Color="{DynamicResource BusyIndicator}" HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
