<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="BoardgameTracker.App.Games.ArkNova.Features.SpecialCards.ArkNovaSpecialCardEditorPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:BoardgameTracker.App.Games.ArkNova.Features.SpecialCards"
    xmlns:core="clr-namespace:BoardgameTracker.Core.Games.ArkNova;assembly=BoardgameTracker.Core"
    xmlns:ark="clr-namespace:BoardgameTracker.App.Games.ArkNova"
    xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization"
    x:DataType="vm:ArkNovaSpecialCardEditorViewModel" Shell.NavBarIsVisible="False">
    <Grid Padding="18" RowDefinitions="Auto,*,Auto" RowSpacing="16">
        <VerticalStackLayout Spacing="8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <ImageButton Source="icon_back.png" Style="{StaticResource IconButton}" Clicked="OnBackClicked" />
                <Label Grid.Column="1" Text="{Binding Title}" FontSize="23" FontAttributes="Bold" VerticalOptions="Center" />
            </Grid>
            <BoxView Style="{StaticResource HeaderDivider}" />
        </VerticalStackLayout>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16">
                <Label Text="{x:Static res:AppResources.SpecialCardName}" FontAttributes="Bold" />
                <Entry Text="{Binding NameText}" MaxLength="{x:Static core:ArkNovaSpecialCard.MaximumNameLength}" Style="{StaticResource InlineFormEntry}" />
                <Border Style="{StaticResource CardBorder}" Padding="12"><ark:ArkNovaSpecialCardView Card="{Binding Preview}" /></Border>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Image Source="{Binding Symbol1Image}" IsVisible="{Binding HasSymbol1}" WidthRequest="32" HeightRequest="32" />
                    <Button Grid.Column="1" Text="{Binding Symbol1Name}" CommandParameter="0" Clicked="OnSymbolClicked" Style="{StaticResource SecondaryActionButton}" MinimumHeightRequest="48" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Image Source="{Binding Symbol2Image}" IsVisible="{Binding HasSymbol2}" WidthRequest="32" HeightRequest="32" />
                    <Button Grid.Column="1" Text="{Binding Symbol2Name}" CommandParameter="1" Clicked="OnSymbolClicked" Style="{StaticResource SecondaryActionButton}" MinimumHeightRequest="48" IsEnabled="{Binding CanChooseSymbol2}" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Image Source="{Binding Symbol3Image}" IsVisible="{Binding HasSymbol3}" WidthRequest="32" HeightRequest="32" />
                    <Button Grid.Column="1" Text="{Binding Symbol3Name}" CommandParameter="2" Clicked="OnSymbolClicked" Style="{StaticResource SecondaryActionButton}" MinimumHeightRequest="48" IsEnabled="{Binding CanChooseSymbol3}" />
                </Grid>
                <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{DynamicResource Danger}" />
            </VerticalStackLayout>
        </ScrollView>
        <Button Grid.Row="2" Text="{x:Static res:AppResources.Save}" Style="{StaticResource PrimaryCompactButton}" Clicked="OnSaveClicked" IsEnabled="{Binding CanSave}" />
        <Grid Grid.RowSpan="3" IsVisible="{Binding IsSymbolPickerVisible}" BackgroundColor="{DynamicResource BusyOverlay}" Padding="12">
            <Border Style="{StaticResource SelectionDialog}">
                <Grid RowDefinitions="Auto,*" RowSpacing="12" MaximumHeightRequest="480">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{x:Static res:AppResources.SelectCardSymbol}" FontAttributes="Bold" FontSize="20" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="{x:Static res:AppResources.Close}" Clicked="OnCloseSymbolPickerClicked" Style="{StaticResource TextActionButton}" />
                    </Grid>
                    <CollectionView Grid.Row="1" ItemsSource="{Binding SymbolOptions}" SelectionMode="None" HeightRequest="330">
                        <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="6" /></CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ArkNovaSymbolOption">
                                <Border Style="{StaticResource CardBorder}" Padding="12,8" MinimumHeightRequest="48">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource SelectedSurface}" />
                                            <Setter Property="Stroke" Value="{DynamicResource SelectedBorder}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnSymbolOptionTapped" CommandParameter="{Binding .}" /></Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="32,*,24" ColumnSpacing="12">
                                        <Image Source="{Binding Image}" IsVisible="{Binding HasImage}" WidthRequest="32" HeightRequest="32" />
                                        <Label Grid.Column="1" Text="{Binding Name}" VerticalOptions="Center" />
                                        <Label Grid.Column="2" Text="✓" IsVisible="{Binding IsSelected}" VerticalOptions="Center" SemanticProperties.Description="{x:Static res:AppResources.SelectedSymbol}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.RowSpan="3" IsVisible="{Binding IsBusy}" BackgroundColor="{DynamicResource BusyOverlay}">
            <ActivityIndicator Color="{DynamicResource BusyIndicator}" IsRunning="True" HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
