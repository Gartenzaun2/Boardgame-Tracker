<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:header="clr-namespace:BoardgameTracker.App.Presentation.Controls" x:Class="BoardgameTracker.App.Features.History.HistoryPage"
 xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
 xmlns:local="clr-namespace:BoardgameTracker.App.Features.History" xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization" Shell.NavBarIsVisible="False">
 <Grid>
     <!-- Keep modal and busy layers outside the content they disable. -->
     <Grid x:Name="PageContent" RowDefinitions="Auto,*" RowSpacing="8" IsEnabled="False">
<Grid.Triggers>
             <MultiTrigger TargetType="Grid">
                 <MultiTrigger.Conditions>
                     <BindingCondition Binding="{Binding IsVisible, Source={x:Reference BusyOverlay}, x:DataType=Grid}" Value="False" />
                 </MultiTrigger.Conditions>
                 <Setter Property="IsEnabled" Value="True" />
             </MultiTrigger>
         </Grid.Triggers>
<VerticalStackLayout Spacing="8">
          <header:AppPageHeader x:Name="PageHeader"
                Title="{x:Static res:AppResources.History}"
                Variant="MainSection" />
      </VerticalStackLayout>
<Grid Grid.Row="1" Padding="16,0,16,16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
<VerticalStackLayout Grid.Row="0" Spacing="0">
       <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Start">
        <Button x:Name="GameChip" Style="{StaticResource FilterChip}" Clicked="OnGameFilterClicked" Margin="0,0,8,4" />
        <Button x:Name="GroupChip" Style="{StaticResource FilterChip}" Clicked="OnGroupFilterClicked" Margin="0,0,0,4" />
       </FlexLayout>
      </VerticalStackLayout>
<Label Grid.Row="1" x:Name="ErrorLabel" IsVisible="False" TextColor="{DynamicResource Danger}" />
<CollectionView Grid.Row="2" x:Name="Sessions" IsGrouped="True" SelectionMode="Single" SelectionChanged="OnSessionSelected">
       <CollectionView.EmptyView><Label Text="{x:Static res:AppResources.HistoryEmpty}" Margin="0,20" /></CollectionView.EmptyView>
       <CollectionView.GroupHeaderTemplate>
        <DataTemplate x:DataType="local:HistoryMonth">
         <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="17" Margin="0,8,0,4" />
        </DataTemplate>
       </CollectionView.GroupHeaderTemplate>
       <CollectionView.ItemTemplate><DataTemplate x:DataType="local:HistoryCard"><Border Padding="12,9" Margin="0,4" Style="{StaticResource CardBorder}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MinimumHeightRequest="44">
        <VerticalStackLayout Spacing="3">
         <Label Text="{Binding Header}" FontSize="13" />
         <Label Text="{Binding GroupName}" FontAttributes="Bold" FontSize="15" />
         <Label Text="{Binding Placements}" FontSize="13" LineBreakMode="WordWrap" />
        </VerticalStackLayout>
        <Image Grid.Column="1" Source="icon_chevron.png" Style="{StaticResource NavigationChevron}" />
        </Grid>
       </Border></DataTemplate></CollectionView.ItemTemplate>
      </CollectionView>
<VerticalStackLayout Grid.Row="3" Spacing="4">
<Label x:Name="ExportScopeHint" Text="{x:Static res:AppResources.ExportHiddenGamesHint}" FontSize="12" TextColor="{DynamicResource TextSecondary}" IsVisible="False" />
<Grid ColumnDefinitions="*,*" ColumnSpacing="8">
       <Button Text="{x:Static res:AppResources.TransferImport}" Clicked="OnImportClicked" Style="{StaticResource SecondaryActionButton}" />
       <Button Grid.Column="1" x:Name="ExportButton" Text="{x:Static res:AppResources.TransferExportMany}" Clicked="OnExportClicked" IsEnabled="False" Style="{StaticResource PrimaryCompactButton}" />
      </Grid>
</VerticalStackLayout>
</Grid>
</Grid>

  <Grid x:Name="BusyOverlay" BackgroundColor="{DynamicResource BusyOverlay}" IsVisible="False"><ActivityIndicator Color="{DynamicResource BusyIndicator}" IsRunning="True" /></Grid>
 </Grid>
</ContentPage>
