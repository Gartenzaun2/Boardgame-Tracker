<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BoardgameTracker.App.Features.Groups.EditGroup.EditGroupPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <Grid Padding="8,8,12,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
            <ImageButton Clicked="OnBackClicked" Source="icon_back.png" Style="{StaticResource IconButton}" ToolTipProperties.Text="{x:Static res:AppResources.Back}" />

            <HorizontalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label FontAttributes="Bold" FontSize="21" Text="{x:Static res:AppResources.EditGroup}" VerticalOptions="Center" />
                <ImageButton Clicked="OnInfoClicked" Source="icon_info.png" Style="{StaticResource IconButton}" ToolTipProperties.Text="{x:Static res:AppResources.EditGroupHint}" />
            </HorizontalStackLayout>

            <Button Grid.Column="2" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryCompactButton}" Text="{x:Static res:AppResources.Save}" VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,12,20,28" Spacing="20">
                <Border Padding="16" BackgroundColor="{StaticResource SurfaceYellow}" Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                            <Label FontAttributes="Bold" Text="{x:Static res:AppResources.GroupName}" VerticalOptions="Center" />
                            <Entry Grid.Column="1" Placeholder="{x:Static res:AppResources.GroupNamePlaceholder}" Text="{Binding GroupName}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" IsVisible="{Binding IsTemporary}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Temporäre Gruppe" VerticalOptions="Center" />
                                <Label FontSize="12" Text="Als permanente Gruppe übernehmen" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding MakePermanent}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Archiviert" VerticalOptions="Center" />
                                <Label FontSize="12" Text="Archivierte Gruppen werden in der normalen Übersicht ausgeblendet." TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding IsArchived}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="2">
                        <Label FontAttributes="Bold" FontSize="18" Text="{x:Static res:AppResources.GroupMembers}" VerticalOptions="Center" />
                        <ImageButton Clicked="OnMembersInfoClicked" Source="icon_info.png" Style="{StaticResource IconButton}" ToolTipProperties.Text="{x:Static res:AppResources.EditGroupMembersHint}" />
                    </HorizontalStackLayout>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Members}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,4" Padding="12" Style="{StaticResource CardBorder}">
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                            <VerticalStackLayout Spacing="2">
                                                <Label FontAttributes="Bold" Text="{Binding Name}" />
                                                <Label FontSize="12" IsVisible="{Binding IsGuest}" Text="{x:Static res:AppResources.Guest}" TextColor="{StaticResource TextSecondary}" />
                                            </VerticalStackLayout>
                                            <Border
                                                Grid.Column="1"
                                                BackgroundColor="{Binding ColorBrush}"
                                                HeightRequest="32"
                                                Stroke="{StaticResource Outline}"
                                                StrokeShape="RoundRectangle 16"
                                                WidthRequest="32">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding Source={x:Reference Page}, Path=BindingContext.ToggleColorPickerCommand}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Image
                                                    HeightRequest="18"
                                                    Source="icon_palette.png"
                                                    WidthRequest="18" />
                                            </Border>
                                            <Button Grid.Column="2" Command="{Binding Source={x:Reference Page}, Path=BindingContext.MoveMemberUpCommand}" CommandParameter="{Binding .}" Padding="10,4" Text="↑" />
                                            <Button Grid.Column="3" Command="{Binding Source={x:Reference Page}, Path=BindingContext.MoveMemberDownCommand}" CommandParameter="{Binding .}" Padding="10,4" Text="↓" />
                                        </Grid>

                                        <HorizontalStackLayout
                                            HorizontalOptions="End"
                                            IsVisible="{Binding IsColorPickerOpen}"
                                            Spacing="8">
                                            <Button BackgroundColor="#8BC4E8" Command="{Binding Source={x:Reference Page}, Path=BindingContext.SetBlueCommand}" CommandParameter="{Binding .}" HeightRequest="34" Padding="0" WidthRequest="34" />
                                            <Button BackgroundColor="#F2D65C" Command="{Binding Source={x:Reference Page}, Path=BindingContext.SetYellowCommand}" CommandParameter="{Binding .}" HeightRequest="34" Padding="0" WidthRequest="34" />
                                            <Button BackgroundColor="#E98A84" Command="{Binding Source={x:Reference Page}, Path=BindingContext.SetRedCommand}" CommandParameter="{Binding .}" HeightRequest="34" Padding="0" WidthRequest="34" />
                                            <Button BackgroundColor="#404040" Command="{Binding Source={x:Reference Page}, Path=BindingContext.SetBlackCommand}" CommandParameter="{Binding .}" HeightRequest="34" Padding="0" WidthRequest="34" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            </VerticalStackLayout>
        </ScrollView>

        <Grid
            Grid.RowSpan="2"
            BackgroundColor="#40FFFFFF"
            InputTransparent="False"
            IsVisible="{Binding IsBusy}">
            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
