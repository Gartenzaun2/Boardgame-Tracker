<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>BoardgameTracker.App</RootNamespace>
    <AssemblyName>BoardgameTracker.App</AssemblyName>

    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiStrictXamlCompilation>true</MauiStrictXamlCompilation>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
    <WarningsAsErrors>$(WarningsAsErrors);XC0022;XC0023;XC0024;XC0025</WarningsAsErrors>

    <ApplicationTitle>Boardgame Tracker</ApplicationTitle>
    <ApplicationId>de.boardgametracker.app</ApplicationId>

    <ApplicationDisplayVersion>0.8.9.4</ApplicationDisplayVersion>
    <ApplicationVersion>25</ApplicationVersion>

    <NeutralLanguage>de</NeutralLanguage>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">30.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png"
              ForegroundFile="Resources\AppIcon\appiconfg.png"
              Color="#F8F5EA"
              BaseSize="1024,1024"
              ForegroundScale="0.95" />
    <MauiSplashScreen Include="Resources\Splash\splash.png"
                      Color="#141A17"
                      BaseSize="512,512" />
    <MauiImage Include="Resources\Images\*" />
    <MauiAsset Include="Resources\Raw\**"
               LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BoardgameTracker.Core\BoardgameTracker.Core.csproj" />
    <ProjectReference Include="..\BoardgameTracker.Application\BoardgameTracker.Application.csproj" />
    <ProjectReference Include="..\BoardgameTracker.Infrastructure\BoardgameTracker.Infrastructure.csproj" />
  </ItemGroup>
</Project>
