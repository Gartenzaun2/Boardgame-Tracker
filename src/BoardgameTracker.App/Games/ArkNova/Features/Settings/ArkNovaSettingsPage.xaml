<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BoardgameTracker.App.Games.ArkNova.Features.Settings.ArkNovaSettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:BoardgameTracker.App.Games.ArkNova.Features.Settings"
    x:DataType="vm:ArkNovaSettingsViewModel"
    Shell.NavBarIsVisible="False">
    <Grid Padding="18" RowDefinitions="Auto,*" RowSpacing="20">
        <VerticalStackLayout Spacing="8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <ImageButton Clicked="OnBackClicked" Source="icon_back.png" Style="{StaticResource IconButton}" />
                <Label Grid.Column="1" Text="{x:Static res:AppResources.ArkNovaSettingsTitle}" FontAttributes="Bold" FontSize="23" VerticalOptions="Center" />
            </Grid>
            <BoxView Style="{StaticResource HeaderDivider}" />
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Row="1" Spacing="12">
            <Border Padding="16" Style="{StaticResource CardBorder}">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="{x:Static res:AppResources.CaptureReputation}" FontAttributes="Bold" />
                        <Label Text="{x:Static res:AppResources.CaptureReputationHint}" FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding CaptureReputation}" />
                </Grid>
            </Border>
            <Border Padding="16" Style="{StaticResource CardBorder}">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="{x:Static res:AppResources.OldScoringDisplay}" FontAttributes="Bold" />
                        <Label Text="{x:Static res:AppResources.OldScoringDisplayHint}" FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding UseOldScoring}" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
