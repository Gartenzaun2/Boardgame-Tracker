<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns:header="clr-namespace:BoardgameTracker.App.Presentation.Controls"
    x:Class="BoardgameTracker.App.Games.ArkNova.Features.GameSessions.Scoring.ArkNovaTieResolutionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:gameNav="clr-namespace:BoardgameTracker.App.Games.ArkNova.Navigation"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization"
    xmlns:vm="clr-namespace:BoardgameTracker.App.Games.ArkNova.Features.GameSessions.Scoring"
    x:DataType="vm:ArkNovaTieResolutionViewModel"
    Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <Style x:Key="PlacementButton" TargetType="Button" BasedOn="{StaticResource SecondaryActionButton}">
            <Setter Property="WidthRequest" Value="32" />
            <Setter Property="HeightRequest" Value="32" />
            <Setter Property="MinimumWidthRequest" Value="32" />
            <Setter Property="MinimumHeightRequest" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
            <Setter Property="BorderColor" Value="{DynamicResource Outline}" />
        </Style>
    </ContentPage.Resources>
    <Grid RowDefinitions="Auto,*" RowSpacing="12" x:Name="ResolutionContent">

<VerticalStackLayout Spacing="8">
            <header:AppPageHeader x:Name="PageHeader"
                Title="{x:Static res:AppResources.ResolveTies}"
                Variant="Subpage"
                BackClicked="OnBackClicked"
                GameName="{x:Static gameNav:ArkNovaGameSessionNavigationHandler.GameDisplayName}"
                BadgeText="{x:Static gameNav:ArkNovaGameSessionNavigationHandler.GameBadgeText}"
                Subtitle="{Binding GroupName}">
                <header:AppPageHeader.Actions>
                    <ImageButton WidthRequest="48" HeightRequest="48" Clicked="OnInfoClicked" Source="icon_info.png" Style="{StaticResource HeaderIconButton}"
                    SemanticProperties.Description="{x:Static res:AppResources.ResolveTies}" />
                </header:AppPageHeader.Actions>
            </header:AppPageHeader>
        </VerticalStackLayout>
<Grid Grid.Row="1" Padding="18,0,18,18" RowDefinitions="*,Auto,Auto" RowSpacing="12">
<ScrollView Grid.Row="0">
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding PlacementGroups}" Spacing="12">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ArkNovaPlacementGroupViewModel">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Title}" FontAttributes="Bold" />
                            <BoxView Style="{StaticResource HeaderDivider}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Players}" Spacing="4">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ArkNovaPlacementPlayerViewModel">
                                        <Border Style="{StaticResource CardBorder}" Padding="8,6">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding HasColor}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{Binding ColorStyle.BackgroundHex}" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                <Label Text="{Binding Name}" FontAttributes="Bold" VerticalOptions="Center" MaxLines="1" LineBreakMode="TailTruncation">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding HasColor}" Value="True">
                                                            <Setter Property="TextColor" Value="{Binding ColorStyle.TextHex}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                                <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" BindableLayout.ItemsSource="{Binding PlacementOptions}" IsVisible="{Binding HasPlacementOptions}" Spacing="4">
                                                    <BindableLayout.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:ArkNovaPlacementOptionViewModel">
                                                            <Button Text="{Binding Text}" CommandParameter="{Binding .}" Clicked="OnPlacementClicked"
                                                                Style="{StaticResource PlacementButton}" SemanticProperties.Description="{Binding Description}">
                                                                <Button.Triggers>
                                                                    <DataTrigger TargetType="Button" Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="BackgroundColor" Value="{DynamicResource SelectedSurface}" />
                                                                        <Setter Property="BorderColor" Value="{DynamicResource SelectedBorder}" />
                                                                        <Setter Property="BorderWidth" Value="2" />
                                                                    </DataTrigger>
                                                                </Button.Triggers>
                                                            </Button>
                                                        </DataTemplate>
                                                    </BindableLayout.ItemTemplate>
                                                </HorizontalStackLayout>
                                                <Label Grid.Column="2" Text="{Binding ScoreText}" HorizontalTextAlignment="End" VerticalOptions="Center">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding HasColor}" Value="True">
                                                            <Setter Property="TextColor" Value="{Binding ColorStyle.TextHex}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>
<Label Grid.Row="1" Text="{Binding ValidationMessage}" IsVisible="{Binding HasValidationMessage}" TextColor="{DynamicResource Danger}" />
<Button Grid.Row="2" Text="{x:Static res:AppResources.SaveScoring}" Style="{StaticResource PrimaryCompactButton}" IsEnabled="{Binding CanFinish}" Clicked="OnFinishClicked" />
</Grid>
</Grid>
</ContentPage>
