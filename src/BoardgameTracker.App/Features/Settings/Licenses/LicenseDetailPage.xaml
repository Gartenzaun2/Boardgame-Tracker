<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:header="clr-namespace:BoardgameTracker.App.Presentation.Controls" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BoardgameTracker.App.Features.Settings.Licenses" xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization"
    x:Class="BoardgameTracker.App.Features.Settings.Licenses.LicenseDetailPage" x:DataType="local:LicenseDetailViewModel"
    Title="{Binding DisplayName}" Shell.NavBarIsVisible="False">
    <Grid>
        <Grid x:Name="PageContent" Padding="18" IsEnabled="{Binding IsIdle}" RowDefinitions="Auto,*" RowSpacing="12">
            <VerticalStackLayout Spacing="8">
                <header:AppPageHeader x:Name="PageHeader"
                Title="{Binding DisplayName}"
                Variant="Subpage"
                BackClicked="OnBackClicked"
                Margin="-18,-18,-18,0" />
            </VerticalStackLayout>
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding VersionText}" IsVisible="{Binding HasVersion}" FontSize="14" />
                    <Label Text="{Binding LicenseDisplayName}" FontSize="17" FontAttributes="Bold" />
                    <Label Text="{Binding SpdxText}" IsVisible="{Binding HasSpdx}" FontSize="12" />
                    <Label Text="{Binding AttributionText}" IsVisible="{Binding HasAttribution}" FontSize="14" LineBreakMode="WordWrap" />
                    <Label Text="{Binding LicenseText}" FontSize="14" LineHeight="1.2" LineBreakMode="WordWrap" />
                    <VerticalStackLayout IsVisible="{Binding HasError}" Spacing="8">
                        <Label Text="{Binding ErrorMessage}" TextColor="{DynamicResource Danger}" />
                        <Button Text="{x:Static res:AppResources.LicensesRetry}" Clicked="OnRetryClicked" Style="{StaticResource SecondaryActionButton}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="{DynamicResource BusyOverlay}">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{DynamicResource BusyIndicator}" HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
