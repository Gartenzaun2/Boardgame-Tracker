<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BoardgameTracker.App.Features.Groups.EditGroup.EditGroupPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:BoardgameTracker.App.Features.Groups"
    xmlns:local="clr-namespace:BoardgameTracker.App.Features.Groups.EditGroup"
    xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization"
    x:DataType="local:EditGroupViewModel"
    Shell.NavBarIsVisible="False">

    <Grid>
        <!-- Keep modal and busy layers outside the content they disable. -->
        <Grid x:Name="PageContent" RowDefinitions="Auto,*" IsEnabled="False">
            <Grid.Triggers>
                <MultiTrigger TargetType="Grid">
                    <MultiTrigger.Conditions>
                        <BindingCondition Binding="{Binding IsBusy}" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter Property="IsEnabled" Value="True" />
                </MultiTrigger>
            </Grid.Triggers>
            <VerticalStackLayout Spacing="8">
                <Grid Padding="8,8,12,8" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                    <ImageButton Clicked="OnBackClicked" SemanticProperties.Description="{x:Static res:AppResources.Back}" Source="icon_back.png" Style="{StaticResource IconButton}" ToolTipProperties.Text="{x:Static res:AppResources.Back}" />

                    <HorizontalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label FontAttributes="Bold" FontSize="21" Text="{x:Static res:AppResources.EditGroup}" VerticalOptions="Center" />
                        <ImageButton Clicked="OnInfoClicked" SemanticProperties.Description="{x:Static res:AppResources.EditGroupHint}" Source="icon_info.png" Style="{StaticResource IconButton}" ToolTipProperties.Text="{x:Static res:AppResources.EditGroupHint}" />
                    </HorizontalStackLayout>

                    <Button Grid.Column="2" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryCompactButton}" Text="{x:Static res:AppResources.Save}" VerticalOptions="Center" />
                </Grid>
                <BoxView Style="{StaticResource HeaderDivider}" />
            </VerticalStackLayout>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="20,12,20,28" Spacing="20">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="110,*" ColumnSpacing="12">
                            <Label FontAttributes="Bold" Text="{x:Static res:AppResources.GroupName}" VerticalOptions="Center" />
                            <Entry Style="{StaticResource InlineFormEntry}" Grid.Column="1" Placeholder="{x:Static res:AppResources.GroupNameExample}" Text="{Binding GroupName}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{x:Static res:AppResources.Archived}" VerticalOptions="Center" />
                                <Label FontSize="12" Text="{x:Static res:AppResources.ArchiveHint}" TextColor="{DynamicResource TextPrimary}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding IsArchived}" IsEnabled="{Binding CanArchive}" />
                        </Grid>
                        <Label Text="{x:Static res:AppResources.GroupArchiveLocked}" IsVisible="{Binding ArchiveLocked}" FontSize="12" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="2">
                            <Label FontAttributes="Bold" FontSize="18" Text="{x:Static res:AppResources.GroupPlayers}" VerticalOptions="Center" />
                            <ImageButton Clicked="OnPlayersInfoClicked" SemanticProperties.Description="{x:Static res:AppResources.EditGroupPlayersHint}" Source="icon_info.png" Style="{StaticResource IconButton}" ToolTipProperties.Text="{x:Static res:AppResources.EditGroupPlayersHint}" />
                        </HorizontalStackLayout>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Players}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:GroupMemberDraft">
                                    <Border Margin="0,4" Padding="12" Style="{StaticResource CardBorder}">
                                        <VerticalStackLayout Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label FontAttributes="Bold" Text="{Binding Name}" />
                                                    <Label FontSize="12" IsVisible="{Binding IsGuest}" Text="{x:Static res:AppResources.Guest}" />
                                                </VerticalStackLayout>
                                                <Button Style="{StaticResource TextActionButton}" MinimumWidthRequest="48" MinimumHeightRequest="48" FontSize="26" Grid.Column="1" Command="{Binding Source={x:Reference Page}, Path=ViewModel.MovePlayerUpCommand, x:DataType=local:EditGroupPage}" CommandParameter="{Binding .}" SemanticProperties.Description="{x:Static res:AppResources.MoveUp}" Text="↑" />
                                                <Button Style="{StaticResource TextActionButton}" MinimumWidthRequest="48" MinimumHeightRequest="48" FontSize="26" Grid.Column="2" Command="{Binding Source={x:Reference Page}, Path=ViewModel.MovePlayerDownCommand, x:DataType=local:EditGroupPage}" CommandParameter="{Binding .}" SemanticProperties.Description="{x:Static res:AppResources.MoveDown}" Text="↓" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static res:AppResources.ChooseGames}" FontAttributes="Bold" FontSize="17" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Games}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:GroupGameSelection">
                                    <Border Style="{StaticResource CardBorder}" Margin="0,4" Padding="8">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanChange}" SemanticProperties.Description="{Binding Name}" />
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" />
                                                <Label Text="{Binding LockReason}" IsVisible="{Binding IsLocked}" FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <Label IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}" TextColor="{DynamicResource Danger}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>


        <Grid
            BackgroundColor="{DynamicResource BusyOverlay}"
            InputTransparent="False"
            IsVisible="{Binding IsBusy}">
            <ActivityIndicator Color="{DynamicResource BusyIndicator}"
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
