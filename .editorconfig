root = true

[*]
end_of_line = lf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
csharp_style_namespace_declarations = file_scoped:suggestion

# Keep C# formatting consistent with the documented K&R style.
# This does not change the preferred separate lines for else/catch/finally.
csharp_new_line_before_open_brace = none
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_preserve_single_line_statements = false

# Simple single statements may omit braces; multiline control flow remains guarded.
csharp_prefer_braces = when_multiline:suggestion

# DI fields and other fields not reassigned after construction should be readonly.
dotnet_style_readonly_field = true:suggestion

# Production symbols use naming warnings; test methods may keep descriptive underscores.
[src/**/*.cs]
dotnet_diagnostic.IDE1006.severity = warning

dotnet_naming_rule.interfaces_use_i_prefix.severity = warning
dotnet_naming_rule.interfaces_use_i_prefix.symbols = interfaces
dotnet_naming_rule.interfaces_use_i_prefix.style = interface_pascal_case
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.interface_pascal_case.required_prefix = I
dotnet_naming_style.interface_pascal_case.capitalization = pascal_case

dotnet_naming_rule.types_use_pascal_case.severity = warning
dotnet_naming_rule.types_use_pascal_case.symbols = named_types
dotnet_naming_rule.types_use_pascal_case.style = pascal_case
dotnet_naming_symbols.named_types.applicable_kinds = class, struct, interface, enum, delegate
dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_rule.public_members_use_pascal_case.severity = warning
dotnet_naming_rule.public_members_use_pascal_case.symbols = public_members
dotnet_naming_rule.public_members_use_pascal_case.style = pascal_case
dotnet_naming_symbols.public_members.applicable_kinds = method, property, event, field
dotnet_naming_symbols.public_members.applicable_accessibilities = public, protected, protected_internal

dotnet_naming_rule.private_fields_use_underscore.severity = warning
dotnet_naming_rule.private_fields_use_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_use_underscore.style = underscore_camel_case
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

# More specific rules preserve the existing PascalCase convention for static fields/constants.
dotnet_naming_rule.private_static_fields_use_pascal_case.severity = warning
dotnet_naming_rule.private_static_fields_use_pascal_case.symbols = private_static_fields
dotnet_naming_rule.private_static_fields_use_pascal_case.style = pascal_case
dotnet_naming_symbols.private_static_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_fields.required_modifiers = static

dotnet_naming_rule.private_constants_use_pascal_case.severity = warning
dotnet_naming_rule.private_constants_use_pascal_case.symbols = private_constants
dotnet_naming_rule.private_constants_use_pascal_case.style = pascal_case
dotnet_naming_symbols.private_constants.applicable_kinds = field
dotnet_naming_symbols.private_constants.applicable_accessibilities = private
dotnet_naming_symbols.private_constants.required_modifiers = const
