<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BoardgameTracker.App.Games.ArkNova.Features.Settings.ArkNovaSettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False">
    <Grid Padding="18" RowDefinitions="Auto,*" RowSpacing="20">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <ImageButton Clicked="OnBackClicked" Source="icon_back.png" Style="{StaticResource IconButton}" />
            <Label Grid.Column="1" Text="Arche-Nova-Einstellungen" FontAttributes="Bold" FontSize="23" VerticalOptions="Center" />
        </Grid>
        <VerticalStackLayout Grid.Row="1" Spacing="12">
            <Border Padding="16" Style="{StaticResource CardBorder}">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Ruf erfassen" FontAttributes="Bold" />
                        <Label Text="Blendet die optionale Rufeingabe in der Wertung ein." FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding CaptureReputation}" />
                </Grid>
            </Border>
            <Border Padding="16" Style="{StaticResource CardBorder}">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="Alte Punkteanzeige" FontAttributes="Bold" />
                        <Label Text="Zeigt die berechneten Punkte um 100 Punkte verschoben an." FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding UseOldScoring}" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
