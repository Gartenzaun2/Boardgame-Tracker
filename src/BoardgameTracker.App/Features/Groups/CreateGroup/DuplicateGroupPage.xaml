<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BoardgameTracker.App.Features.Groups.CreateGroup" xmlns:models="clr-namespace:BoardgameTracker.App.Features.Groups"
    xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization" x:Class="BoardgameTracker.App.Features.Groups.CreateGroup.DuplicateGroupPage"
    x:Name="Page" x:DataType="local:CreateGroupViewModel" Shell.NavBarIsVisible="False">
    <Grid>
        <Grid Padding="18" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="16" IsEnabled="{Binding IsIdle}">
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <ImageButton Source="icon_back.png" Style="{StaticResource IconButton}" Clicked="OnBackClicked" SemanticProperties.Description="{x:Static res:AppResources.Back}" />
                    <Label Grid.Column="1" Text="{x:Static res:AppResources.DuplicateGroupTitle}" FontSize="21" FontAttributes="Bold" VerticalOptions="Center" />
                </Grid>
                <BoxView Style="{StaticResource HeaderDivider}" />
            </VerticalStackLayout>
            <CollectionView Grid.Row="1" ItemsSource="{Binding Duplicates}" SelectionMode="None">
                <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="12" /></CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DuplicateGroupRow">
                        <Border Style="{StaticResource CardBorder}" Padding="12">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="18" />
                                <Label Text="{Binding Members}" />
                                <Label Text="{x:Static res:AppResources.Archived}" IsVisible="{Binding IsArchived}" FontSize="12" />
                                <Button Text="{Binding ActionText}" Style="{StaticResource SecondaryActionButton}"
                                    Command="{Binding Source={x:Reference Page}, Path=ViewModel.ReuseDuplicateCommand, x:DataType=local:DuplicateGroupPage}" CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Label Grid.Row="2" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{DynamicResource Danger}" />
            <VerticalStackLayout Grid.Row="3" Spacing="16">
                <BoxView Style="{StaticResource HeaderDivider}" />
                <Button Text="{x:Static res:AppResources.CreateAdditionalGroup}" Command="{Binding CreateAdditionalGroupCommand}" Style="{StaticResource SecondaryActionButton}" />
            </VerticalStackLayout>
        </Grid>
        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="{DynamicResource BusyOverlay}"><ActivityIndicator IsRunning="{Binding IsBusy}" Color="{DynamicResource BusyIndicator}" HorizontalOptions="Center" VerticalOptions="Center" /></Grid>
    </Grid>
</ContentPage>
