<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BoardgameTracker.App.Games.ArkNova.Features.GameSessions.Scoring.ArkNovaPlayerScoringPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization"
    xmlns:vm="clr-namespace:BoardgameTracker.App.Games.ArkNova.Features.GameSessions.Scoring"
    x:DataType="vm:ArkNovaPlayerScoringViewModel"
    Shell.NavBarIsVisible="False">
    <Grid Padding="18" RowDefinitions="Auto,*,Auto" RowSpacing="18">
        <VerticalStackLayout Spacing="8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <ImageButton Clicked="OnDoneClicked" Source="icon_back.png" Style="{StaticResource IconButton}" />
                <Label Grid.Column="1" Text="{Binding Name}" FontAttributes="Bold" FontSize="23" VerticalOptions="Center" />
            </Grid>
            <BoxView Style="{StaticResource HeaderDivider}" />
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Row="1" Spacing="16">
            <VerticalStackLayout Spacing="4">
                <Label Text="{x:Static res:AppResources.Attractiveness}" FontAttributes="Bold" />
                <Grid ColumnDefinitions="*,Auto">
                    <Entry Style="{StaticResource InlineFormEntry}" Text="{Binding AttractivenessText}" Keyboard="Numeric" MaxLength="3" Placeholder="0–113" />
                    <Label Grid.Column="1" Text="0–113" Margin="10,0,0,0" VerticalOptions="Center" TextColor="{DynamicResource TextPrimary}" />
                </Grid>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="4">
                <Label Text="{x:Static res:AppResources.Conservation}" FontAttributes="Bold" />
                <Grid ColumnDefinitions="*,Auto">
                    <Entry Style="{StaticResource InlineFormEntry}" Text="{Binding ConservationText}" Keyboard="Numeric" MaxLength="2" Placeholder="0–41" />
                    <Label Grid.Column="1" Text="0–41" Margin="10,0,0,0" VerticalOptions="Center" TextColor="{DynamicResource TextPrimary}" />
                </Grid>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="4" IsVisible="{Binding IsReputationVisible}">
                <Label Text="{x:Static res:AppResources.Reputation}" FontAttributes="Bold" />
                <Grid ColumnDefinitions="*,Auto">
                    <Entry Style="{StaticResource InlineFormEntry}" Text="{Binding ReputationText}" Keyboard="Numeric" MaxLength="2" Placeholder="{x:Static res:AppResources.OptionalValue}" />
                    <Label Grid.Column="1" Text="{x:Static res:AppResources.OptionalReputation}" Margin="10,0,0,0" VerticalOptions="Center" TextColor="{DynamicResource TextPrimary}" />
                </Grid>
            </VerticalStackLayout>
            <Border Padding="14" Style="{StaticResource CardBorder}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="{x:Static res:AppResources.CalculatedPoints}" />
                    <Label Grid.Column="1" Text="{Binding ScoreText}" FontAttributes="Bold" FontSize="20" />
                </Grid>
            </Border>
            <Label Text="{Binding ValidationMessage}" TextColor="{DynamicResource Danger}" FontSize="12" />
        </VerticalStackLayout>
        <Button Grid.Row="2" Text="{x:Static res:AppResources.Done}" Style="{StaticResource PrimaryCompactButton}" Clicked="OnDoneClicked" />
    </Grid>
</ContentPage>
