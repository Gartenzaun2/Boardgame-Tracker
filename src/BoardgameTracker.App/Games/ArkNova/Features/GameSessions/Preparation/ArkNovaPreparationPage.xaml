<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns:header="clr-namespace:BoardgameTracker.App.Presentation.Controls"
    x:Class="BoardgameTracker.App.Games.ArkNova.Features.GameSessions.Preparation.ArkNovaPreparationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:colors="clr-namespace:BoardgameTracker.App.Presentation.PlayerColors"
    xmlns:presentation="clr-namespace:BoardgameTracker.App.Presentation"
    xmlns:gameNav="clr-namespace:BoardgameTracker.App.Games.ArkNova.Navigation"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BoardgameTracker.App.Games.ArkNova.Features.GameSessions.Preparation"
    xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization"
    x:DataType="local:ArkNovaPreparationViewModel"
    Shell.NavBarIsVisible="False">

    <Grid>
        <!-- Keep modal and busy layers outside the content they disable. -->
        <Grid x:Name="PageContent" RowDefinitions="Auto,*" RowSpacing="12" IsEnabled="{Binding CanInteract}">

<VerticalStackLayout Spacing="8">
            <header:AppPageHeader x:Name="PageHeader"
                Title="{x:Static res:AppResources.PrepareGame}"
                Variant="Subpage"
                BackClicked="OnBackClicked"
                GameName="{x:Static gameNav:ArkNovaGameSessionNavigationHandler.GameDisplayName}"
                BadgeText="{x:Static gameNav:ArkNovaGameSessionNavigationHandler.GameBadgeText}"
                Subtitle="{Binding GroupName}">
                <header:AppPageHeader.Actions>
                    <ImageButton WidthRequest="48" HeightRequest="48"
                            x:Name="RandomStartButton"
                            Clicked="OnRandomStartClicked"
                            Source="icon_dice.png"
                            Style="{StaticResource HeaderIconButton}"
                            SemanticProperties.Description="{x:Static res:AppResources.DetermineStartingPlayer}"
                            ToolTipProperties.Text="{x:Static res:AppResources.DetermineStartingPlayer}" />
                </header:AppPageHeader.Actions>
            </header:AppPageHeader>
            </VerticalStackLayout>
<Grid Grid.Row="1" Padding="18,0,18,14" RowDefinitions="Auto,*,Auto" RowSpacing="12">
<Label
                Grid.Row="0"
                IsVisible="{Binding HasError}"
                Text="{Binding ErrorMessage}"
                TextColor="{DynamicResource Danger}" />
<ScrollView Grid.Row="1" Margin="0,-6,0,0">
                <VerticalStackLayout Spacing="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{x:Static res:AppResources.PreviousGameSection}" FontSize="12" FontAttributes="Bold" />
                        <Label Text="{Binding LastGameSessionText}" FontSize="13" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10">
                        <Button
                            Clicked="OnDrawZooPlansClicked"
                            Style="{StaticResource SecondaryActionButton}"
                            Text="{x:Static res:AppResources.DrawZooPlans}" />
                        <Button
                            Grid.Column="1"
                            Clicked="OnRotateOrderClicked"
                            Style="{StaticResource SecondaryActionButton}"
                            Text="{x:Static res:AppResources.RotateOrder}" />
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Players}" Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:ArkNovaPreparationPlayerViewModel">
                                <Border
                                    Margin="0,0,0,10"
                                    Padding="12"
                                    BackgroundColor="{Binding ColorBrush}"
                                    Style="{StaticResource CardBorder}">
                                    <VerticalStackLayout Spacing="9">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                                            <Border
                                                HeightRequest="32"
                                                Stroke="#66FFFFFF"
                                                StrokeShape="RoundRectangle 16"
                                                WidthRequest="32">
                                                <Label TextColor="{Binding PlayerTextColor}"
                                                    FontAttributes="Bold"
                                                    HorizontalTextAlignment="Center"
                                                    Text="{Binding Position}"
                                                    VerticalTextAlignment="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                                <Label TextColor="{Binding PlayerTextColor}" FontAttributes="Bold" FontSize="17" Text="{Binding Name}" />
                                                <Label TextColor="{Binding PlayerTextColor}" FontSize="12" Text="{Binding ColorName}" />
                                            </VerticalStackLayout>
                                            <ImageButton
                                                Grid.Column="2"
                                                Clicked="OnMoveUpClicked" CommandParameter="{Binding .}"
                                                Source="icon_up.png" IsEnabled="{Binding CanMoveUp}"
                                                presentation:IconTint.Color="{Binding PlayerTextColor}"
                                                Style="{StaticResource IconButton}"
                                                SemanticProperties.Description="{x:Static res:AppResources.MoveUp}" />
                                            <ImageButton
                                                Grid.Column="3"
                                                Clicked="OnMoveDownClicked" CommandParameter="{Binding .}"
                                                Source="icon_down.png" IsEnabled="{Binding CanMoveDown}"
                                                presentation:IconTint.Color="{Binding PlayerTextColor}"
                                                Style="{StaticResource IconButton}"
                                                SemanticProperties.Description="{x:Static res:AppResources.MoveDown}" />
                                            <ImageButton
                                                Grid.Column="4"
                                                Clicked="OnColorClicked"
                                                Source="icon_palette.png"
                                                presentation:IconTint.Color="{Binding PlayerTextColor}"
                                                Style="{StaticResource IconButton}"
                                                SemanticProperties.Description="{x:Static res:AppResources.ChooseColor}"
                                                ToolTipProperties.Text="{x:Static res:AppResources.ChooseColor}" />
                                        </Grid>

                                        <HorizontalStackLayout
                                            HorizontalOptions="End"
                                            IsVisible="{Binding IsColorPickerOpen}"
                                            Spacing="8">
                                            <Button
                                                BackgroundColor="{x:Static colors:PlayerColorPresentation.BlueBackground}"
                                                SemanticProperties.Description="{x:Static res:AppResources.Blue}"
                                                Clicked="OnBlueColorClicked"
                                                IsVisible="{Binding CanChooseBlue}"
                                                HeightRequest="44"
                                                Padding="0"
                                                Text=""
                                                WidthRequest="44" />
                                            <Button
                                                BackgroundColor="{x:Static colors:PlayerColorPresentation.YellowBackground}"
                                                SemanticProperties.Description="{x:Static res:AppResources.Yellow}"
                                                Clicked="OnYellowColorClicked"
                                                IsVisible="{Binding CanChooseYellow}"
                                                HeightRequest="44"
                                                Padding="0"
                                                Text=""
                                                WidthRequest="44" />
                                            <Button
                                                BackgroundColor="{x:Static colors:PlayerColorPresentation.RedBackground}"
                                                SemanticProperties.Description="{x:Static res:AppResources.Red}"
                                                Clicked="OnRedColorClicked"
                                                IsVisible="{Binding CanChooseRed}"
                                                HeightRequest="44"
                                                Padding="0"
                                                Text=""
                                                WidthRequest="44" />
                                            <Button
                                                BackgroundColor="{x:Static colors:PlayerColorPresentation.BlackBackground}"
                                                SemanticProperties.Description="{x:Static res:AppResources.Black}"
                                                Clicked="OnBlackColorClicked"
                                                IsVisible="{Binding CanChooseBlack}"
                                                HeightRequest="44"
                                                Padding="0"
                                                Text=""
                                                WidthRequest="44" />
                                        </HorizontalStackLayout>

                                        <Button Text="{x:Static res:AppResources.ChooseZooPlan}"
                                                Style="{StaticResource SecondaryActionButton}"
                                                Clicked="OnChooseZooPlanClicked" IsVisible="{Binding CanChooseManualZooPlan}" />
                                        <Grid ColumnDefinitions="*,2*,*" ColumnSpacing="4" IsVisible="{Binding HasManualZooPlan}">
                                        <Border Grid.Column="1" Padding="4" BackgroundColor="#BFFFFFFF"
                                                Stroke="{DynamicResource SelectedBorder}" StrokeThickness="3" StrokeShape="RoundRectangle 10"
                                                SemanticProperties.Description="{Binding ManualZooPlanDescription}"
                                                SemanticProperties.Hint="{x:Static res:AppResources.ChooseZooPlan}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnManualZooPlanTapped" CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Grid HeightRequest="88">
                                                <Image Source="{Binding ManualZooPlanIconSource}" Aspect="Fill" HeightRequest="81" />
                                                <Border Margin="0,3,0,0" Padding="7,2" BackgroundColor="#DFFFFFFF"
                                                        HorizontalOptions="Center" VerticalOptions="Start" StrokeThickness="0" StrokeShape="RoundRectangle 10">
                                                    <Label Text="{Binding ManualZooPlanLabel}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource GameGraphicText}" />
                                                </Border>
                                                <Label Text="{x:Static res:AppResources.ZooPlanSelected}" FontSize="10" FontAttributes="Bold"
                                                       HorizontalOptions="Center" VerticalOptions="End" BackgroundColor="{DynamicResource IconSurface}" TextColor="{DynamicResource GameGraphicText}" />
                                            </Grid>
                                        </Border>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding HasZooPlans}">
                                            <Border
                                                Padding="4"
                                                BackgroundColor="#BFFFFFFF"
                                                Stroke="{DynamicResource SelectedBorder}"
                                                StrokeShape="RoundRectangle 10"
                                                StrokeThickness="{Binding Option1StrokeThickness}"
                                                SemanticProperties.Description="{Binding ZooPlanOption1Description}">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        CommandParameter="{Binding .}"
                                                        Tapped="OnZooPlanOption1Tapped" />
                                                </Border.GestureRecognizers>
                                                <Grid HeightRequest="88">
                                                    <Image
                                                        Aspect="Fill"
                                                        HeightRequest="81"
                                                        Source="{Binding ZooPlanOption1IconSource}" />
                                                    <Label Text="{x:Static res:AppResources.ZooPlanSelected}" IsVisible="{Binding Option1Selected}" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="End" BackgroundColor="{DynamicResource IconSurface}" TextColor="{DynamicResource GameGraphicText}" />

                                                    <Border
                                                        Margin="0,3,0,0"
                                                        Padding="7,2"
                                                        BackgroundColor="#DFFFFFFF"
                                                        HorizontalOptions="Center"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 10"
                                                        VerticalOptions="Start">
                                                        <Label TextColor="{DynamicResource GameGraphicText}"
                                                            FontAttributes="Bold"
                                                            FontSize="14"
                                                            Text="{Binding ZooPlanOption1.Number}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Border
                                                Grid.Column="1"
                                                Padding="4"
                                                BackgroundColor="#BFFFFFFF"
                                                Stroke="{DynamicResource SelectedBorder}"
                                                StrokeShape="RoundRectangle 10"
                                                StrokeThickness="{Binding Option2StrokeThickness}"
                                                SemanticProperties.Description="{Binding ZooPlanOption2Description}">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        CommandParameter="{Binding .}"
                                                        Tapped="OnZooPlanOption2Tapped" />
                                                </Border.GestureRecognizers>
                                                <Grid HeightRequest="88">
                                                    <Image
                                                        Aspect="Fill"
                                                        HeightRequest="81"
                                                        Source="{Binding ZooPlanOption2IconSource}" />
                                                    <Label Text="{x:Static res:AppResources.ZooPlanSelected}" IsVisible="{Binding Option2Selected}" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="End" BackgroundColor="{DynamicResource IconSurface}" TextColor="{DynamicResource GameGraphicText}" />

                                                    <Border
                                                        Margin="0,3,0,0"
                                                        Padding="7,2"
                                                        BackgroundColor="#DFFFFFFF"
                                                        HorizontalOptions="Center"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 10"
                                                        VerticalOptions="Start">
                                                        <Label TextColor="{DynamicResource GameGraphicText}"
                                                            FontAttributes="Bold"
                                                            FontSize="14"
                                                            Text="{Binding ZooPlanOption2.Number}" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
<Button
                Grid.Row="2"
                Clicked="OnStartClicked"
                IsEnabled="{Binding CanStart}"
                Style="{StaticResource PrimaryCompactButton}"
                Text="{x:Static res:AppResources.StartGame}" />
</Grid>
</Grid>

        <Grid IsVisible="{Binding IsZooPlanPickerVisible}" BackgroundColor="{DynamicResource ModalOverlay}" Padding="18">
            <Border Style="{StaticResource SelectionDialog}">
                <Grid RowDefinitions="Auto,*" RowSpacing="12" MaximumHeightRequest="440">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <ImageButton Source="icon_back.png" Clicked="OnZooPlanPickerBackClicked" Style="{StaticResource IconButton}"
                                     SemanticProperties.Description="{x:Static res:AppResources.Back}" />
                        <Label Grid.Column="1" Text="{x:Static res:AppResources.ChooseZooPlan}" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <CollectionView Grid.Row="1" ItemsSource="{Binding ZooPlanOptions}" SelectionMode="None">
                        <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="7" /></CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="local:ArkNovaManualZooPlanOptionViewModel">
                                <Border Padding="3" Stroke="{DynamicResource Outline}" StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{DynamicResource Surface}" SemanticProperties.Description="{Binding Description}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource SelectedSurface}" />
                                            <Setter Property="Stroke" Value="{DynamicResource SelectedBorder}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnManualZooPlanOptionTapped" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Border Padding="9,6" StrokeThickness="0" StrokeShape="RoundRectangle 7" MinimumHeightRequest="44">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsAssignedToOtherPlayer}" Value="True">
                                                <Setter Property="Stroke" Value="{DynamicResource Danger}" />
                                                <Setter Property="StrokeThickness" Value="2" />
                                                <Setter Property="StrokeDashArray" Value="4,3" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding Title}" VerticalOptions="Center" />
                                            <Label Grid.Column="1" Text="✓" IsVisible="{Binding IsSelected}" VerticalOptions="Center" FontAttributes="Bold" />
                                        </Grid>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>

        <Grid
            BackgroundColor="{DynamicResource BusyOverlay}"
            InputTransparent="False"
            IsVisible="{Binding IsBusy}">
            <ActivityIndicator Color="{DynamicResource BusyIndicator}"
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
