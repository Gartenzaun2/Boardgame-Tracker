<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BoardgameTracker.App.Features.GameSessions.Result.ArkNovaResultPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:BoardgameTracker.App.Features.GameSessions.Result"
    x:DataType="vm:ArkNovaResultViewModel"
    Shell.NavBarIsVisible="False">
    <Grid Padding="18" RowDefinitions="Auto,*,Auto" RowSpacing="14">
        <VerticalStackLayout Spacing="1">
            <Label Text="Ergebnis" FontAttributes="Bold" FontSize="24" />
            <Label Text="{Binding GroupName}" TextColor="{StaticResource TextSecondary}" />
        </VerticalStackLayout>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Players}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ArkNovaResultPlayerViewModel">
                    <Border Margin="0,0,0,8" Padding="12" Style="{StaticResource CardBorder}">
                        <Grid ColumnDefinitions="44,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                            <Label Text="{Binding PlacementText}" FontAttributes="Bold" FontSize="22" VerticalOptions="Center" Grid.RowSpan="3" />
                            <Label Grid.Column="1" Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                            <Label Grid.Column="2" Text="{Binding ScoreText}" FontAttributes="Bold" FontSize="16" />
                            <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding RawValuesText}" FontSize="11" TextColor="{StaticResource TextSecondary}" />
                            <Label Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding SpecialCardsText}" FontSize="10" TextColor="{StaticResource TextSecondary}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Grid.Row="2" Text="Fertig" Style="{StaticResource PrimaryCompactButton}" Clicked="OnDoneClicked" />
    </Grid>
</ContentPage>
