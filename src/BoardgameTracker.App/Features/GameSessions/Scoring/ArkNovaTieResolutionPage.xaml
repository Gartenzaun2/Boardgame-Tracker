<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BoardgameTracker.App.Features.GameSessions.Scoring.ArkNovaTieResolutionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:BoardgameTracker.App.Features.GameSessions.Scoring"
    x:DataType="vm:ArkNovaTieResolutionViewModel"
    Shell.NavBarIsVisible="False">
    <Grid Padding="18" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <ImageButton Clicked="OnBackClicked" Source="icon_back.png" Style="{StaticResource IconButton}" />
            <VerticalStackLayout Grid.Column="1" Spacing="1">
                <Label Text="Gleichstände bearbeiten" FontAttributes="Bold" FontSize="22" />
                <Label Text="Nur punktgleiche Spieler können innerhalb ihres Bereichs verschoben werden." FontSize="11" TextColor="{StaticResource TextSecondary}" />
            </VerticalStackLayout>
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="FramesHost" Spacing="8" />
        </ScrollView>
        <Label Grid.Row="2" Text="{Binding ValidationMessage}" TextColor="{StaticResource Danger}" FontSize="12" />
        <Button Grid.Row="3" Text="Wertung speichern" Style="{StaticResource PrimaryCompactButton}" IsEnabled="{Binding CanFinish}" Clicked="OnFinishClicked" />
    </Grid>
</ContentPage>
