<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BoardgameTracker.App.Features.Games.ListGames.GamesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization"
    Shell.NavBarIsVisible="False">
    <Grid Padding="20,22" RowDefinitions="Auto,*" RowSpacing="14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Label Text="{x:Static res:AppResources.Games}" FontAttributes="Bold" FontSize="28" VerticalOptions="Center" />
            <ImageButton Grid.Column="1" Clicked="OnInfoClicked" Source="icon_info.png" Style="{StaticResource IconButton}"
                         SemanticProperties.Description="{x:Static res:AppResources.GameCatalogHint}"
                         ToolTipProperties.Text="{x:Static res:AppResources.GameCatalogHint}" />
        </Grid>
        <Border Grid.Row="1" Padding="18" Style="{StaticResource CardBorder}" VerticalOptions="Start">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnArkNovaTapped" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="5">
                    <Label Text="{x:Static res:AppResources.ArkNova}" FontAttributes="Bold" FontSize="20" />
                    <Label Text="{x:Static res:AppResources.SupportedGame}" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
                <Label Grid.Column="1" Text="›" FontSize="26" VerticalOptions="Center" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
