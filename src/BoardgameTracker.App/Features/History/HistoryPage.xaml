<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BoardgameTracker.App.Features.History.HistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization"
    Shell.NavBarIsVisible="False">
    <Grid Padding="20,22" RowDefinitions="Auto,Auto,*" RowSpacing="14">
        <Label Text="{x:Static res:AppResources.History}" FontAttributes="Bold" FontSize="28" />
        <Label Grid.Row="1" Text="{x:Static res:AppResources.HistoryHint}" TextColor="{StaticResource TextSecondary}" />
    </Grid>
</ContentPage>
