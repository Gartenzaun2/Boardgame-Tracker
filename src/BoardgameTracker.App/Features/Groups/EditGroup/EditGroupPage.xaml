<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:header="clr-namespace:BoardgameTracker.App.Presentation.Controls" xmlns:models="clr-namespace:BoardgameTracker.App.Features.Groups"
    xmlns:local="clr-namespace:BoardgameTracker.App.Features.Groups.EditGroup" xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization"
    x:Class="BoardgameTracker.App.Features.Groups.EditGroup.EditGroupPage" x:Name="Page"
    x:DataType="local:EditGroupViewModel" Shell.NavBarIsVisible="False">
    <Grid>
        <!-- Keep modal and busy layers outside the content they disable. -->
        <Grid x:Name="PageContent" RowDefinitions="Auto,*" IsEnabled="False">
            <Grid.Triggers>
                <MultiTrigger TargetType="Grid">
                    <MultiTrigger.Conditions>
                        <BindingCondition Binding="{Binding IsBusy}" Value="False" />
                        <BindingCondition Binding="{Binding IsChoosingGame}" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter Property="IsEnabled" Value="True" />
                </MultiTrigger>
            </Grid.Triggers>
            <VerticalStackLayout Spacing="8">
                <header:AppPageHeader x:Name="PageHeader" Title="{x:Static res:AppResources.EditGroup}"
                    Variant="Subpage" BackClicked="OnBackClicked">
                    <header:AppPageHeader.Actions>
                        <ImageButton WidthRequest="48" HeightRequest="48" Source="icon_info.png" Style="{StaticResource HeaderIconButton}"
                            Clicked="OnInfoClicked" SemanticProperties.Description="{x:Static res:AppResources.EditGroupHint}"
                            ToolTipProperties.Text="{x:Static res:AppResources.EditGroupHint}" />
                        <Button Style="{StaticResource PrimaryCompactButton}" Text="{Binding SaveText}" Command="{Binding SaveCommand}" />
                    </header:AppPageHeader.Actions>
                </header:AppPageHeader>
                <Label Margin="20,0" Text="{x:Static res:AppResources.EditorSavedHint}" IsVisible="{Binding IsSaved}" />
                <Label Margin="20,0" TextColor="{DynamicResource Danger}" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" />
            </VerticalStackLayout>

            <ScrollView Grid.Row="1" IsEnabled="{Binding CanEdit}">
                <VerticalStackLayout Padding="20,12,20,28" Spacing="20">
                    <VerticalStackLayout Spacing="16">
                        <Label FontAttributes="Bold" FontSize="18" Text="{x:Static res:AppResources.GroupName}" />
                        <Entry Style="{StaticResource InlineFormEntry}" Placeholder="{x:Static res:AppResources.GroupNameExample}" Text="{Binding GroupName}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{x:Static res:AppResources.Archived}" VerticalOptions="Center" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="1" IsToggled="{Binding IsArchived}" IsEnabled="{Binding CanArchive}" />
                        </Grid>
                        <Label FontSize="12" Text="{x:Static res:AppResources.GroupArchiveLocked}"
                            IsVisible="{Binding CanArchive, Converter={StaticResource NegateBool}}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="2">
                            <Label FontAttributes="Bold" FontSize="18" VerticalOptions="Center" Text="{x:Static res:AppResources.GroupPlayers}" />
                            <ImageButton Source="icon_info.png" Style="{StaticResource IconButton}" Clicked="OnPlayersInfoClicked"
                                SemanticProperties.Description="{x:Static res:AppResources.EditGroupPlayersHint}"
                                ToolTipProperties.Text="{x:Static res:AppResources.EditGroupPlayersHint}" />
                        </HorizontalStackLayout>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Players}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:GroupMemberDraft">
                                    <Border Margin="0,4" Padding="12" Style="{StaticResource CardBorder}">
                                        <VerticalStackLayout Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                <VerticalStackLayout Spacing="2">
                                                    <HorizontalStackLayout Spacing="8">
                                                        <Label FontAttributes="Bold" Text="{Binding Position}" />
                                                        <Label FontAttributes="Bold" Text="{Binding Name}" />
                                                    </HorizontalStackLayout>
                                                    <Label FontSize="12" Text="{x:Static res:AppResources.Guest}" IsVisible="{Binding IsGuest}" />
                                                </VerticalStackLayout>
                                                <Button Grid.Column="1" Style="{StaticResource TextActionButton}" Text="↑" FontSize="26" MinimumWidthRequest="48" MinimumHeightRequest="48"
                                                    Command="{Binding Source={x:Reference Page}, Path=ViewModel.MovePlayerUpCommand, x:DataType=local:EditGroupPage}"
                                                    CommandParameter="{Binding .}" IsEnabled="{Binding CanMoveUp}" SemanticProperties.Description="{x:Static res:AppResources.MoveUp}" />
                                                <Button Grid.Column="2" Style="{StaticResource TextActionButton}" Text="↓" FontSize="26" MinimumWidthRequest="48" MinimumHeightRequest="48"
                                                    Command="{Binding Source={x:Reference Page}, Path=ViewModel.MovePlayerDownCommand, x:DataType=local:EditGroupPage}"
                                                    CommandParameter="{Binding .}" IsEnabled="{Binding CanMoveDown}" SemanticProperties.Description="{x:Static res:AppResources.MoveDown}" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label FontAttributes="Bold" FontSize="18" Text="{x:Static res:AppResources.GamesSection}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedGames}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:GroupGameSelection">
                                    <Border Margin="0,4" Padding="12" Style="{StaticResource CardBorder}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <VerticalStackLayout VerticalOptions="Center">
                                                <Label FontAttributes="Bold" Text="{Binding Name}" />
                                                <Label FontSize="12" TextColor="{DynamicResource TextSecondary}" Text="{Binding LockReason}" IsVisible="{Binding IsLocked}" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1" Style="{StaticResource TextActionButton}" Text="×" FontSize="26" TextColor="{DynamicResource Danger}"
                                                Command="{Binding Source={x:Reference Page}, Path=ViewModel.RemoveGameCommand, x:DataType=local:EditGroupPage}"
                                                CommandParameter="{Binding .}" IsEnabled="{Binding CanChange}" SemanticProperties.Description="{x:Static res:AppResources.Remove}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Button HorizontalOptions="Start" Style="{StaticResource SecondaryActionButton}" Text="{x:Static res:AppResources.AddGame}"
                            IsEnabled="{Binding HasAvailableGames}" Clicked="OnChooseGameClicked" />
                    </VerticalStackLayout>

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <Grid Padding="18" BackgroundColor="{DynamicResource ModalOverlay}" IsVisible="{Binding IsChoosingGame}">
            <Border Style="{StaticResource SelectionDialog}">
                <Grid RowDefinitions="Auto,*" RowSpacing="12" MaximumHeightRequest="400">
                    <Grid ColumnDefinitions="Auto,*">
                        <ImageButton Source="icon_back.png" Style="{StaticResource IconButton}" Clicked="OnCloseGameClicked"
                            SemanticProperties.Description="{x:Static res:AppResources.Back}" />
                        <Label Grid.Column="1" FontSize="19" FontAttributes="Bold" VerticalOptions="Center" Text="{x:Static res:AppResources.AddGame}" />
                    </Grid>
                    <CollectionView Grid.Row="1" HeightRequest="300" ItemsSource="{Binding AvailableGames}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:GroupGameSelection">
                                <Border Padding="12" Margin="0,4" Style="{StaticResource CardBorder}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnGameTapped" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Name}" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>

        <Grid BackgroundColor="{DynamicResource BusyOverlay}" InputTransparent="False" IsVisible="{Binding IsBusy}">
            <ActivityIndicator Color="{DynamicResource BusyIndicator}" HorizontalOptions="Center" VerticalOptions="Center" IsRunning="{Binding IsBusy}" />
        </Grid>
    </Grid>
</ContentPage>
