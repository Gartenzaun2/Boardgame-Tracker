<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BoardgameTracker.App.Games.ManualGames.Features.Settings"
    xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization"
    xmlns:controls="clr-namespace:BoardgameTracker.App.Presentation.Controls"
    x:Class="BoardgameTracker.App.Games.ManualGames.Features.Settings.ManualGameEditorPage"
    x:DataType="local:ManualGameEditorViewModel" Shell.NavBarIsVisible="False">
    <Grid>
        <Grid RowDefinitions="Auto,*" RowSpacing="12" IsEnabled="{Binding CanInteract}">

            <!-- Page header: title, game context and return command. -->
            <controls:AppPageHeader Title="{Binding Title}" BadgeText="{Binding HeaderBadge}" GameName="{Binding GameName}" Variant="Subpage" BackCommand="{Binding GoBackCommand}" />
            <Grid Grid.Row="1" Style="{StaticResource SettingsPageBody}">
                <ScrollView>
                    <VerticalStackLayout Style="{StaticResource SettingsContent}" Padding="0,0,0,20">

                        <!-- Persisted completion keeps departure available while all settings stay frozen. -->
                        <Label Text="{x:Static res:AppResources.EditorSavedHint}" IsVisible="{Binding IsSaveCompleted}" />

                        <!-- Editable configuration: immediate enablement, metadata and capture options. -->
                        <VerticalStackLayout Style="{StaticResource SettingsContent}" IsEnabled="{Binding CanEdit}">

                            <!-- Enablement: an immediate preference write, independent of saving the configuration. -->
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingsRow}" IsVisible="{Binding IsEditing}">
                                <Label Text="{x:Static res:AppResources.ShowGame}" Style="{StaticResource SettingsItemLabel}" />
                                <Switch Grid.Column="1" IsToggled="{Binding IsEnabled, Mode=OneWay}" IsEnabled="{Binding IsEnablementLocked, Converter={StaticResource NegateBool}}"
                                    Toggled="OnEnabledToggled"
                                    SemanticProperties.Description="{x:Static res:AppResources.ShowGame}" />
                            </Grid>
                            <Label Text="{x:Static res:AppResources.GameDisableBlocked}" IsVisible="{Binding IsEnablementLocked}" Style="{StaticResource SettingsHintLabel}" />

                            <!-- Game metadata: name, badge and player limits. -->
                            <Label Text="{x:Static res:AppResources.SettingsGeneral}" Style="{StaticResource SettingsSectionTitle}" />
                            <Label Text="{x:Static res:AppResources.ManualGameName}" Style="{StaticResource SettingsItemLabel}" />
                            <Entry Text="{Binding GameName}" SemanticProperties.Description="{x:Static res:AppResources.ManualGameName}" />
                            <Label Text="{x:Static res:AppResources.ManualGameBadge}" Style="{StaticResource SettingsItemLabel}" />
                            <Entry Text="{Binding BadgeText}" SemanticProperties.Description="{x:Static res:AppResources.ManualGameBadge}" />
                            <Grid ColumnDefinitions="*,100" Style="{StaticResource SettingsRow}">
                                <Label Text="{x:Static res:AppResources.ManualMinPlayers}" Style="{StaticResource SettingsItemLabel}" />
                                <Entry Grid.Column="1" Text="{Binding MinimumPlayers}" Keyboard="Numeric" SemanticProperties.Description="{x:Static res:AppResources.ManualMinPlayers}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,100" Style="{StaticResource SettingsRow}">
                                <Label Text="{x:Static res:AppResources.ManualMaxPlayers}" Style="{StaticResource SettingsItemLabel}" />
                                <Entry Grid.Column="1" Text="{Binding MaximumPlayers}" Keyboard="Numeric" IsReadOnly="{Binding IsEditing}" SemanticProperties.Description="{x:Static res:AppResources.ManualMaxPlayers}" />
                            </Grid>
                            <Label Text="{x:Static res:AppResources.ManualMaximumLocked}" IsVisible="{Binding IsEditing}" Style="{StaticResource SettingsHintLabel}" />

                            <!-- Scoring: points, winner capture, ties and result derivation. -->
                            <Label Text="{x:Static res:AppResources.Scoring}" Style="{StaticResource SettingsSectionTitle}" />
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingsRow}">
                                <Label Text="{x:Static res:AppResources.CapturePoints}" Style="{StaticResource SettingsItemLabel}" />
                                <Switch Grid.Column="1" IsToggled="{Binding CapturePoints}" SemanticProperties.Description="{x:Static res:AppResources.CapturePoints}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingsRow}" Margin="16,0,0,0">
                                <Label Text="{x:Static res:AppResources.AllowNegativePoints}" Style="{StaticResource SettingsItemLabel}" SemanticProperties.Hint="{x:Static res:AppResources.NegativePointsRequirement}" />
                                <Switch Grid.Column="1" IsToggled="{Binding AllowNegativePoints}" IsEnabled="{Binding CapturePoints}" SemanticProperties.Description="{x:Static res:AppResources.AllowNegativePoints}" SemanticProperties.Hint="{x:Static res:AppResources.NegativePointsRequirement}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingsRow}">
                                <Label Text="{x:Static res:AppResources.CaptureWinner}" Style="{StaticResource SettingsItemLabel}" />
                                <Switch Grid.Column="1" IsToggled="{Binding CaptureWinner}" SemanticProperties.Description="{x:Static res:AppResources.CaptureWinner}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingsRow}" Margin="16,0,0,0">
                                <Label Text="{x:Static res:AppResources.CapturePlacements}" Style="{StaticResource SettingsItemLabel}" SemanticProperties.Hint="{x:Static res:AppResources.WinnerCaptureRequirement}" />
                                <Switch Grid.Column="1" IsToggled="{Binding CapturePlacements}" IsEnabled="{Binding CaptureWinner}" SemanticProperties.Description="{x:Static res:AppResources.CapturePlacements}" SemanticProperties.Hint="{x:Static res:AppResources.WinnerCaptureRequirement}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingsRow}" Margin="16,0,0,0">
                                <Label Text="{x:Static res:AppResources.AllowTies}" Style="{StaticResource SettingsItemLabel}" SemanticProperties.Hint="{x:Static res:AppResources.WinnerCaptureRequirement}" />
                                <Switch Grid.Column="1" IsToggled="{Binding AllowTies}" IsEnabled="{Binding CaptureWinner}" SemanticProperties.Description="{x:Static res:AppResources.AllowTies}" SemanticProperties.Hint="{x:Static res:AppResources.WinnerCaptureRequirement}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Style="{StaticResource SettingsRow}" Margin="16,0,0,0">
                                <Label Text="{x:Static res:AppResources.ResultFromPoints}" Style="{StaticResource SettingsItemLabel}" />
                                <ImageButton Grid.Column="1" Source="icon_info.png" Style="{StaticResource IconButton}"
                                    Clicked="OnResultModeInfoClicked"
                                    ToolTipProperties.Text="{x:Static res:AppResources.ResultFromPointsRequirement}" SemanticProperties.Description="{x:Static res:AppResources.ResultFromPointsRequirement}" />
                                <Grid Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource SettingsLookupHost}">
                                    <Border Style="{StaticResource SettingsLookupFrame}" />
                                    <Button Text="{Binding ResultModeText}" Style="{StaticResource SettingsLookup}" IsEnabled="{Binding CanDeriveResult}"
                                        Clicked="OnResultModeClicked"
                                        SemanticProperties.Description="{x:Static res:AppResources.ResultFromPoints}" SemanticProperties.Hint="{x:Static res:AppResources.ResultFromPointsRequirement}" />
                                </Grid>
                            </Grid>

                            <!-- Preparation options: capture player order and colors. -->
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingsRow}">
                                <Label Text="{x:Static res:AppResources.CapturePlayerOrder}" Style="{StaticResource SettingsItemLabel}" />
                                <Switch Grid.Column="1" IsToggled="{Binding CapturePlayerOrder}" SemanticProperties.Description="{x:Static res:AppResources.CapturePlayerOrder}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingsRow}">
                                <Label Text="{x:Static res:AppResources.CapturePlayerColors}" Style="{StaticResource SettingsItemLabel}" />
                                <Switch Grid.Column="1" IsToggled="{Binding CapturePlayerColors}" SemanticProperties.Description="{x:Static res:AppResources.CapturePlayerColors}" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Completion: save or delete, with inline errors and session locks. -->
                        <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{DynamicResource Danger}" />
                        <Button Text="{Binding SaveText}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryCompactButton}" />
                        <Button Text="{x:Static res:AppResources.DeleteManualGame}" Clicked="OnDeleteClicked" Style="{StaticResource DangerButton}" IsVisible="{Binding IsEditing}" IsEnabled="{Binding CanDelete}" />
                        <Label Text="{x:Static res:AppResources.ManualDeleteBlocked}" IsVisible="{Binding HasSessions}" Style="{StaticResource SettingsHintLabel}" />
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Grid>

        <!-- Busy overlay: cover the page while a load, write or departure is pending. -->
        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="{DynamicResource BusyOverlay}">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{DynamicResource BusyIndicator}" HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
