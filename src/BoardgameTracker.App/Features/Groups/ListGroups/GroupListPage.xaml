<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BoardgameTracker.App.Features.Groups.ListGroups.GroupListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization"
    Shell.NavBarIsVisible="False">

    <Grid Padding="20,22" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
        <VerticalStackLayout Spacing="4">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label
                    FontAttributes="Bold"
                    FontSize="28"
                    Text="{x:Static res:AppResources.Groups}"
                    VerticalOptions="Center" />
                <Button
                    Grid.Column="1"
                    Clicked="OnCreateGroupClicked"
                    Style="{StaticResource CompactActionButton}"
                    Text="{x:Static res:AppResources.NewGroup}"
                    VerticalOptions="Center" />
            </Grid>

            <VerticalStackLayout Spacing="2">
                <HorizontalStackLayout Spacing="6">
                    <Switch IsToggled="{Binding IncludeTemporary}" />
                    <Label Text="Temporär" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="6">
                    <Switch IsToggled="{Binding IncludeArchived}" />
                    <Label Text="Archiviert" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <Label
            Grid.Row="1"
            Text="{Binding ErrorMessage}"
            TextColor="{StaticResource Danger}" />

        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Groups}">
            <CollectionView.EmptyView>
                <Border Padding="20" Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label
                            FontAttributes="Bold"
                            FontSize="20"
                            Text="{x:Static res:AppResources.NoGroupsYet}" />
                        <Label Text="{x:Static res:AppResources.CreateFirstGroupHint}" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,0,0,12"
                        Padding="16"
                        BackgroundColor="{StaticResource SurfaceYellow}"
                        Style="{StaticResource CardBorder}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="5">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnGroupTapped" CommandParameter="{Binding Id}" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="20"
                                    Text="{Binding Name}" />
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding MemberNames}" />
                                    <Label FontAttributes="Italic" FontSize="12" IsVisible="{Binding IsTemporary}" Text="Temporär" TextColor="{StaticResource TextSecondary}" />
                                    <Label FontAttributes="Italic" FontSize="12" IsVisible="{Binding IsArchived}" Text="Archiviert" TextColor="{StaticResource TextSecondary}" />
                                </HorizontalStackLayout>
                                <Label
                                    FontSize="12"
                                    Text="{Binding LastPlayedText}"
                                    TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                            <ImageButton
                                Grid.Column="1"
                                Clicked="OnEditGroupClicked"
                                CommandParameter="{Binding Id}"
                                Source="icon_edit.png"
                                Style="{StaticResource IconButton}"
                                ToolTipProperties.Text="{x:Static res:AppResources.EditGroup}"
                                VerticalOptions="Start" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator
            Grid.Row="3"
            HorizontalOptions="Center"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}" />

        <Grid
            Grid.RowSpan="4"
            BackgroundColor="#40FFFFFF"
            InputTransparent="False"
            IsVisible="{Binding IsBusy}">
            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                VerticalOptions="Center" />
        </Grid>

        <Grid
            Grid.RowSpan="4"
            BackgroundColor="#40FFFFFF"
            InputTransparent="False"
            IsVisible="{Binding IsNavigating}">
            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsNavigating}"
                VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
