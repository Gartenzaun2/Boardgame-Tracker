<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns:gameNav="clr-namespace:BoardgameTracker.App.Games.ArkNova.Navigation" xmlns:header="clr-namespace:BoardgameTracker.App.Presentation.Controls"
    x:Class="BoardgameTracker.App.Games.ArkNova.Features.Settings.ArkNovaSettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:visibility="clr-namespace:BoardgameTracker.App.Features.Settings.MyGames"
    xmlns:vm="clr-namespace:BoardgameTracker.App.Games.ArkNova.Features.Settings"
    x:DataType="vm:ArkNovaSettingsViewModel"
    Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*" RowSpacing="14">

<VerticalStackLayout Spacing="8">
            <header:AppPageHeader x:Name="PageHeader"
                Title="{x:Static res:AppResources.Settings}"
                Variant="Subpage"
                BackClicked="OnBackClicked"
                GameName="{x:Static gameNav:ArkNovaGameSessionNavigationHandler.GameDisplayName}"
                BadgeText="{x:Static gameNav:ArkNovaGameSessionNavigationHandler.GameBadgeText}" />
        </VerticalStackLayout>
<Grid Grid.Row="1" Style="{StaticResource SettingsPageBody}" RowDefinitions="*">
<ScrollView Grid.Row="0">
            <VerticalStackLayout Style="{StaticResource SettingsContent}">
                <Label Text="{x:Static res:AppResources.SettingsGeneral}" Style="{StaticResource SettingsSectionTitle}" />
                <Grid x:Name="VisibilityPanel" x:DataType="visibility:GameActivationRow" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4" Style="{StaticResource SettingsRow}">
                    <Label Text="{x:Static res:AppResources.ShowGame}" VerticalOptions="Center" />
                    <Switch Grid.Column="1" IsToggled="{Binding IsEnabled, Mode=OneWay}" IsEnabled="{Binding CanToggle}" Toggled="OnGameVisibilityToggled" SemanticProperties.Description="{x:Static res:AppResources.ShowGame}" />
                    <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Static res:AppResources.GameDisableBlocked}" IsVisible="{Binding IsLocked}" FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                </Grid>
                <Label x:Name="VisibilityError" IsVisible="False" TextColor="{DynamicResource Danger}" />
                <Label Text="{x:Static res:AppResources.Scoring}" Style="{StaticResource SettingsSectionTitle}" />
                <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingsRow}">
                    <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                        <Label Text="{x:Static res:AppResources.CaptureReputation}" />
                        <Label Text="{x:Static res:AppResources.CaptureReputationHint}" FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding CaptureReputation}" SemanticProperties.Description="{x:Static res:AppResources.CaptureReputation}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingsRow}">
                    <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                        <Label Text="{x:Static res:AppResources.OldScoringDisplay}" />
                        <Label Text="{x:Static res:AppResources.OldScoringDisplayHint}" FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding UseOldScoring}" SemanticProperties.Description="{x:Static res:AppResources.OldScoringDisplay}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingsRow}">
                    <Label Text="{x:Static res:AppResources.GameMaterial}" Style="{StaticResource SettingsSectionTitle}" />
                    <ImageButton Grid.Column="1" Source="icon_info.png" Style="{StaticResource IconButton}"
                                 Clicked="OnMaterialInfoClicked" SemanticProperties.Description="{x:Static res:AppResources.GameMaterialHint}"
                                 ToolTipProperties.Text="{x:Static res:AppResources.GameMaterialHint}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingsRow}">
                    <Label Text="{x:Static res:AppResources.ContentLanguage}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="{Binding SelectedContentLanguage.Name}" Clicked="OnContentLanguageClicked" Style="{StaticResource SettingsLookup}" SemanticProperties.Description="{x:Static res:AppResources.ContentLanguage}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingsRow}">
                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnSpecialCardsClicked" /></Grid.GestureRecognizers>
                    <Label Text="{x:Static res:AppResources.SpecialCardManagementTitle}" VerticalOptions="Center" />
                    <Image Grid.Column="1" Source="icon_chevron.png" Style="{StaticResource NavigationChevron}" />
                </Grid>
                <Label Text="{x:Static res:AppResources.DebugSettings}" Style="{StaticResource SettingsSectionTitle}" />
                <Grid ColumnDefinitions="*,Auto" Style="{StaticResource SettingsRow}">
                    <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnPhotoDatasetClicked" /></Grid.GestureRecognizers>
                    <Label Text="{x:Static res:AppResources.PhotoDatasetTitle}" VerticalOptions="Center" />
                    <Image Grid.Column="1" Source="icon_chevron.png" Style="{StaticResource NavigationChevron}" />
                </Grid>
            </VerticalStackLayout>
        </ScrollView>
</Grid>
</Grid>
</ContentPage>
