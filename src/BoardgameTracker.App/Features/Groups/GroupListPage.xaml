<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BoardgameTracker.App.Features.Groups.GroupListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization"
    Title="{x:Static res:AppResources.Groups}">

    <Grid Padding="24" RowDefinitions="Auto,Auto,*" RowSpacing="18">
        <Label
            FontAttributes="Bold"
            FontSize="30"
            Text="{Binding Heading}" />

        <Label
            Grid.Row="1"
            FontSize="16"
            Text="{x:Static res:AppResources.FirstRunHint}" />

        <Border
            Grid.Row="2"
            Padding="20"
            Stroke="#D7DBD3"
            StrokeShape="RoundRectangle 16">
            <VerticalStackLayout Spacing="12">
                <Label
                    FontAttributes="Bold"
                    FontSize="20"
                    Text="{x:Static res:AppResources.Groups}" />
                <Label Text="{x:Static res:AppResources.NoGroupsYet}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
