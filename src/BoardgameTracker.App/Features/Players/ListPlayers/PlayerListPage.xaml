<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:header="clr-namespace:BoardgameTracker.App.Presentation.Controls" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BoardgameTracker.App.Features.Players.ListPlayers" xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization"
    x:Class="BoardgameTracker.App.Features.Players.ListPlayers.PlayerListPage" x:DataType="local:PlayerListViewModel" Shell.NavBarIsVisible="False">
    <Grid>
        <Grid Padding="18" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12" IsEnabled="{Binding IsIdle}">
            <VerticalStackLayout Spacing="8">
                <header:AppPageHeader x:Name="PageHeader"
                Title="{x:Static res:AppResources.Participants}"
                Variant="MainSection"
                Margin="-18,-18,-18,0">
                <header:AppPageHeader.Actions>
                    <ImageButton WidthRequest="48" HeightRequest="48" Source="icon_info.png" Style="{StaticResource IconButton}" Clicked="OnInfoClicked" SemanticProperties.Description="{x:Static res:AppResources.Participants}" />
                </header:AppPageHeader.Actions>
            </header:AppPageHeader>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                    <Button Text="{x:Static res:AppResources.Players}" Clicked="OnPlayersSegmentClicked" Style="{StaticResource SecondaryActionButton}">
                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding ShowPlayers}" Value="True"><Setter Property="BackgroundColor" Value="{DynamicResource SelectedSurface}" /><Setter Property="BorderColor" Value="{DynamicResource SelectedBorder}" /><Setter Property="BorderWidth" Value="2" /></DataTrigger></Button.Triggers>
                    </Button>
                    <Button Grid.Column="1" Text="{x:Static res:AppResources.Groups}" Clicked="OnGroupsSegmentClicked" IsEnabled="{Binding HasPlayers}" Style="{StaticResource SecondaryActionButton}">
                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding ShowGroups}" Value="True"><Setter Property="BackgroundColor" Value="{DynamicResource SelectedSurface}" /><Setter Property="BorderColor" Value="{DynamicResource SelectedBorder}" /><Setter Property="BorderWidth" Value="2" /></DataTrigger></Button.Triggers>
                    </Button>
                </Grid>
                <Label Text="{x:Static res:AppResources.FirstPlayerHint}" IsVisible="{Binding HasNoPlayers}" />
            </VerticalStackLayout>
            <HorizontalStackLayout Grid.Row="1" Spacing="16" IsVisible="{Binding ShowPlayers}">
                <HorizontalStackLayout Spacing="4"><Switch IsToggled="{Binding IncludeGuests}" /><Label Text="{x:Static res:AppResources.ShowGuests}" VerticalOptions="Center" /></HorizontalStackLayout>
                <HorizontalStackLayout Spacing="4"><Switch IsToggled="{Binding IncludeArchived}" /><Label Text="{x:Static res:AppResources.ShowArchived}" VerticalOptions="Center" /></HorizontalStackLayout>
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Row="1" Spacing="4" IsVisible="{Binding ShowGroups}"><Switch IsToggled="{Binding IncludeArchivedGroups}" /><Label Text="{x:Static res:AppResources.ShowArchived}" VerticalOptions="Center" /></HorizontalStackLayout>
            <CollectionView Grid.Row="2" ItemsSource="{Binding Players}" SelectionMode="None" IsVisible="{Binding ShowPlayers}">
                <CollectionView.EmptyView><Label Text="{x:Static res:AppResources.PlayersEmpty}" /></CollectionView.EmptyView>
                <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="8" /></CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:PlayerListRow">
                        <Border Style="{StaticResource CardBorder}" Padding="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Name}" FontSize="17" FontAttributes="Bold" />
                                    <Label Text="{Binding CreatedText}" FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{x:Static res:AppResources.Guest}" IsVisible="{Binding IsGuest}" FontSize="12" />
                                        <Label Text="{x:Static res:AppResources.Archived}" IsVisible="{Binding IsArchived}" FontSize="12" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                                <ImageButton Grid.Column="1" Source="icon_edit.png" Style="{StaticResource IconButton}" Clicked="OnEditClicked" CommandParameter="{Binding .}" SemanticProperties.Description="{x:Static res:AppResources.EditPlayer}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <CollectionView Grid.Row="2" ItemsSource="{Binding Groups}" SelectionMode="None" IsVisible="{Binding ShowGroups}">
                <CollectionView.EmptyView><Label Text="{x:Static res:AppResources.NoGroupsYet}" /></CollectionView.EmptyView>
                <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="8" /></CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:ManagedGroupRow">
                        <Border Style="{StaticResource CardBorder}" Padding="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Name}" FontSize="17" FontAttributes="Bold" />
                                    <Label Text="{Binding Members}" />
                                    <Label Text="{x:Static res:AppResources.Archived}" IsVisible="{Binding IsArchived}" FontSize="12" />
                                </VerticalStackLayout>
                                <ImageButton Grid.Column="1" Source="icon_edit.png" Style="{StaticResource IconButton}" Clicked="OnEditGroupClicked" CommandParameter="{Binding .}" SemanticProperties.Description="{x:Static res:AppResources.EditGroup}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <VerticalStackLayout Grid.Row="3" Spacing="8">
                <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{DynamicResource Danger}" />
                <Button Text="{x:Static res:AppResources.AddPlayer}" IsVisible="{Binding ShowPlayers}" Clicked="OnAddPlayerClicked" Style="{StaticResource PrimaryCompactButton}" />
                <Button Text="{x:Static res:AppResources.CreateGroup}" IsVisible="{Binding ShowGroups}" Clicked="OnAddGroupClicked" Style="{StaticResource PrimaryCompactButton}" />
            </VerticalStackLayout>
        </Grid>
        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="{DynamicResource BusyOverlay}"><ActivityIndicator IsRunning="{Binding IsBusy}" Color="{DynamicResource BusyIndicator}" HorizontalOptions="Center" VerticalOptions="Center" /></Grid>
    </Grid>
</ContentPage>
