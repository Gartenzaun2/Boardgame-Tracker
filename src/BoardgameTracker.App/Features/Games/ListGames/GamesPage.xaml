<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns:header="clr-namespace:BoardgameTracker.App.Presentation.Controls" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BoardgameTracker.App.Features.Games.ListGames" xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization"
    x:Class="BoardgameTracker.App.Features.Games.ListGames.GamesPage" x:DataType="local:GamesViewModel" Shell.NavBarIsVisible="False">
    <Grid>
        <Grid Padding="20,22" RowDefinitions="Auto,*,Auto" RowSpacing="14">
            <VerticalStackLayout Spacing="8">
                <header:AppPageHeader x:Name="PageHeader"
                Title="{x:Static res:AppResources.Games}"
                Variant="MainSection"
                Margin="-20,-22,-20,0">
                <header:AppPageHeader.Actions>
                    <ImageButton WidthRequest="48" HeightRequest="48" Source="icon_info.png" Style="{StaticResource IconButton}" Clicked="OnInfoClicked" SemanticProperties.Description="{x:Static res:AppResources.GameCatalogHint}" />
                </header:AppPageHeader.Actions>
            </header:AppPageHeader>
            </VerticalStackLayout>
            <CollectionView Grid.Row="1" ItemsSource="{Binding Games}" SelectionMode="None">
                <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="12" /></CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:PlayGameRow">
                        <Border Style="{StaticResource CardBorder}" Padding="16">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnGameTapped" CommandParameter="{Binding Key}" /></Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding Name}" FontSize="20" FontAttributes="Bold" VerticalOptions="Center" />
                                <Image Source="icon_active_session.png" IsVisible="{Binding HasOpenSession}" HeightRequest="20" WidthRequest="20" VerticalOptions="Center" SemanticProperties.Description="{x:Static res:AppResources.OpenGameSession}" />
                            </HorizontalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Label Grid.Row="2" Text="{Binding ErrorMessage}" TextColor="{DynamicResource Danger}" />
        </Grid>
        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="{DynamicResource BusyOverlay}"><ActivityIndicator IsRunning="{Binding IsBusy}" Color="{DynamicResource BusyIndicator}" HorizontalOptions="Center" VerticalOptions="Center" /></Grid>
    </Grid>
</ContentPage>
