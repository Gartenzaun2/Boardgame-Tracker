<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:header="clr-namespace:BoardgameTracker.App.Presentation.Controls"
    xmlns:local="clr-namespace:BoardgameTracker.App.Features.Players.EditPlayer"
    xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization"
    x:Class="BoardgameTracker.App.Features.Players.EditPlayer.EditPlayerPage"
    x:DataType="local:EditPlayerViewModel"
    Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*" RowSpacing="12" IsEnabled="{Binding IsBusy, Converter={StaticResource NegateBool}}">
        <VerticalStackLayout Spacing="8">
            <header:AppPageHeader x:Name="PageHeader"
                Title="{Binding Title}"
                Variant="Subpage"
                BackCommand="{Binding GoBackCommand}" />
            <Label Text="{x:Static res:AppResources.EditorSavedHint}" IsVisible="{Binding IsSaveCompleted}" Margin="18,0" />
            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{DynamicResource Danger}" Margin="18,0" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" Padding="18,0,18,18" RowDefinitions="*,Auto" RowSpacing="12">
            <ScrollView Grid.Row="0">
                <VerticalStackLayout Spacing="12" IsEnabled="{Binding CanEdit}">
                    <Label Text="{x:Static res:AppResources.PlayerNameLabel}" FontAttributes="Bold" />
                    <Entry Text="{Binding PlayerName}" Style="{StaticResource InlineFormEntry}" />
                    <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsCreateMode, Converter={StaticResource NegateBool}}">
                        <Label Text="{x:Static res:AppResources.Archived}" VerticalOptions="Center" />
                        <Switch IsToggled="{Binding IsPlayerArchived}" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsCreateMode}">
                        <Label Text="{x:Static res:AppResources.Guest}" VerticalOptions="Center" />
                        <Switch IsToggled="{Binding IsPlayerGuest}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding IsCreateMode}">
                <Button Text="{x:Static res:AppResources.AddAnotherPlayer}" Command="{Binding SaveAndAddAnotherCommand}" Style="{StaticResource SecondaryActionButton}" />
                <Button Grid.Column="1" Text="{x:Static res:AppResources.Done}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryCompactButton}" />
            </Grid>
            <Button Grid.Row="1" IsVisible="{Binding IsCreateMode, Converter={StaticResource NegateBool}}" Text="{Binding SaveText}" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryCompactButton}" />
        </Grid>
    </Grid>
</ContentPage>
