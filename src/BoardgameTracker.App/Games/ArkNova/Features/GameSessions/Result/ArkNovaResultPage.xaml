<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BoardgameTracker.App.Games.ArkNova.Features.GameSessions.Result.ArkNovaResultPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization"
    xmlns:gameNav="clr-namespace:BoardgameTracker.App.Games.ArkNova.Navigation"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ark="clr-namespace:BoardgameTracker.App.Games.ArkNova"
    xmlns:data="clr-namespace:BoardgameTracker.Application.Games.ArkNova.SpecialCards;assembly=BoardgameTracker.Application"
    xmlns:vm="clr-namespace:BoardgameTracker.App.Games.ArkNova.Features.GameSessions.Result"
    x:DataType="vm:ArkNovaResultViewModel"
    Shell.NavBarIsVisible="False">
    <Grid Padding="18" RowDefinitions="Auto,*,Auto" RowSpacing="14">
        <VerticalStackLayout Spacing="8">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <ImageButton x:Name="BackButton" IsVisible="False" Source="icon_back.png" Style="{StaticResource IconButton}" Clicked="OnBackClicked" SemanticProperties.Description="{x:Static res:AppResources.Back}" />
            <VerticalStackLayout Grid.Column="1" Spacing="1">
                <Label Text="{x:Static res:AppResources.Result}" FontAttributes="Bold" FontSize="24" />


            </VerticalStackLayout>
                <ImageButton x:Name="EditButton" Grid.Column="2" IsVisible="False" Source="icon_edit.png" Style="{StaticResource IconButton}" Clicked="OnEditClicked" SemanticProperties.Description="{x:Static res:AppResources.EditResult}" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Border BackgroundColor="Transparent" Stroke="{DynamicResource GameContextBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 14" HeightRequest="28" Padding="12,0" HorizontalOptions="Start" SemanticProperties.Description="{x:Static gameNav:ArkNovaGameSessionNavigationHandler.GameDisplayName}">
                    <Label Text="{x:Static gameNav:ArkNovaGameSessionNavigationHandler.GameBadgeText}" FontSize="13" TextColor="{DynamicResource GameContextText}" VerticalOptions="Center" />
                </Border>
                    <Label Grid.Column="1" Text="{Binding GroupName}" FontSize="14" VerticalOptions="Center" />
                </Grid>
                <Label Text="{Binding DurationText}" FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                <BoxView Style="{StaticResource HeaderDivider}" />
            <Label Text="{Binding StartingOrderText}" FontSize="13" />
        </VerticalStackLayout>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Players}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ArkNovaResultPlayerViewModel">
                    <Border Margin="0,0,0,8" Padding="12" Style="{StaticResource CardBorder}" BackgroundColor="{Binding Tint}">
                        <Grid ColumnDefinitions="44,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                            <Label TextColor="{Binding PlayerTextColor}" Text="{Binding PlacementText}" FontAttributes="Bold" FontSize="22" VerticalOptions="Center" Grid.RowSpan="3" />
                            <Label TextColor="{Binding PlayerTextColor}" Grid.Column="1" Text="{Binding Name}" FontAttributes="Bold" FontSize="16" />
                            <Label TextColor="{Binding PlayerTextColor}" Grid.Column="2" Text="{Binding ScoreText}" FontAttributes="Bold" FontSize="16" />
                            <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding RawValuesText}" FontSize="11" TextColor="{Binding PlayerTextColor}" />
                            <VerticalStackLayout Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" BindableLayout.ItemsSource="{Binding Cards}" Spacing="4">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="data:ArkNovaSpecialCardData">
                                        <Border Style="{StaticResource CardBorder}" Padding="6"><ark:ArkNovaSpecialCardView Card="{Binding .}" /></Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button x:Name="DoneButton" Grid.Row="2" Text="{x:Static res:AppResources.Done}" Style="{StaticResource PrimaryCompactButton}" Clicked="OnDoneClicked" />
    </Grid>
</ContentPage>
