<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:BoardgameTracker.App.Presentation.Controls" xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization" xmlns:local="clr-namespace:BoardgameTracker.App.Games.ManualGames.Features.GameSessions.Result" x:Class="BoardgameTracker.App.Games.ManualGames.Features.GameSessions.Result.ManualResultPage" x:DataType="local:ManualResultViewModel" Shell.NavBarIsVisible="False">
    <Grid>
        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
            <controls:AppPageHeader Title="{x:Static res:AppResources.Result}" BadgeText="{Binding BadgeText}" GameName="{Binding GameName}" Subtitle="{Binding GroupName}" Metadata="{Binding Metadata}" Variant="Subpage" BackClicked="OnDoneClicked" />
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="20,0" Spacing="12">
                    <Label Text="{Binding StartingOrderText}" IsVisible="{Binding HasStartingOrder}" LineBreakMode="WordWrap" />
                    <Label Text="{Binding ErrorMessage}" TextColor="{DynamicResource Danger}" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Players}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:ManualResultPlayerViewModel">
                                <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,10">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding HasColor}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{Binding ColorBrush}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Label Text="{Binding PlacementText}" TextColor="{DynamicResource TextPrimary}" IsVisible="{Binding HasPlacement}" FontSize="20" FontAttributes="Bold">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding HasColor}" Value="True">
                                                    <Setter Property="TextColor" Value="{Binding PlayerTextColor}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <VerticalStackLayout Grid.Column="1">
                                            <Label Text="{Binding Name}" TextColor="{DynamicResource TextPrimary}" FontSize="17" FontAttributes="Bold" LineBreakMode="WordWrap">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding HasColor}" Value="True">
                                                        <Setter Property="TextColor" Value="{Binding PlayerTextColor}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Label Text="{Binding ColorName}" TextColor="{DynamicResource TextPrimary}" IsVisible="{Binding HasColor}" FontSize="12">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding HasColor}" Value="True">
                                                        <Setter Property="TextColor" Value="{Binding PlayerTextColor}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </VerticalStackLayout>
                                        <Label Text="{Binding PointsText}" TextColor="{DynamicResource TextPrimary}" Grid.Column="2" IsVisible="{Binding HasPoints}" FontAttributes="Bold">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding HasColor}" Value="True">
                                                    <Setter Property="TextColor" Value="{Binding PlayerTextColor}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
            <Button Grid.Row="2" Margin="20,0,20,20" Text="{x:Static res:AppResources.Done}" Clicked="OnDoneClicked" Style="{StaticResource PrimaryCompactButton}" />
        </Grid>
        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="{DynamicResource BusyOverlay}">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{DynamicResource BusyIndicator}" HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>