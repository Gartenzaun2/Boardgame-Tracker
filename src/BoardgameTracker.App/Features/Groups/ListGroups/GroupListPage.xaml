<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BoardgameTracker.App.Features.Groups.ListGroups.GroupListPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization"
    Shell.NavBarIsVisible="False">

    <Grid Padding="24" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto">
            <Label
                FontAttributes="Bold"
                FontSize="30"
                Text="{x:Static res:AppResources.Groups}"
                VerticalOptions="Center" />
            <Button
                Grid.Column="1"
                Clicked="OnCreateGroupClicked"
                Text="{x:Static res:AppResources.NewGroup}" />
        </Grid>

        <Label
            Grid.Row="1"
            Text="{Binding ErrorMessage}"
            TextColor="#B3261E" />

        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Groups}">
            <CollectionView.EmptyView>
                <Border
                    Padding="20"
                    Stroke="#D7DBD3"
                    StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="8">
                        <Label
                            FontAttributes="Bold"
                            FontSize="20"
                            Text="{x:Static res:AppResources.NoGroupsYet}" />
                        <Label Text="{x:Static res:AppResources.CreateFirstGroupHint}" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,0,0,12"
                        Padding="18"
                        Stroke="#D7DBD3"
                        StrokeShape="RoundRectangle 16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="6">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="20"
                                    Text="{Binding Name}" />
                                <Label Text="{Binding MemberNames}" />
                                <Label
                                    FontSize="12"
                                    Text="{Binding LastPlayedText}" />
                            </VerticalStackLayout>
                            <Button
                                Grid.Column="1"
                                BackgroundColor="Transparent"
                                Clicked="OnEditGroupClicked"
                                CommandParameter="{Binding Id}"
                                FontSize="20"
                                HeightRequest="44"
                                Text="✎"
                                ToolTipProperties.Text="{x:Static res:AppResources.EditGroup}"
                                VerticalOptions="Start"
                                WidthRequest="44" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator
            Grid.Row="3"
            HorizontalOptions="Center"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}" />
    </Grid>
</ContentPage>
