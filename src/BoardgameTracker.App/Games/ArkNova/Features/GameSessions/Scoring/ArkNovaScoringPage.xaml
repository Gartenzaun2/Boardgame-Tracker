<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns:header="clr-namespace:BoardgameTracker.App.Presentation.Controls"
    x:Class="BoardgameTracker.App.Games.ArkNova.Features.GameSessions.Scoring.ArkNovaScoringPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:gameNav="clr-namespace:BoardgameTracker.App.Games.ArkNova.Navigation"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:BoardgameTracker.App.Games.ArkNova.Features.GameSessions.Scoring"
    xmlns:presentation="clr-namespace:BoardgameTracker.App.Presentation"
    xmlns:ark="clr-namespace:BoardgameTracker.App.Games.ArkNova"
    xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization"
    x:DataType="vm:ArkNovaScoringViewModel"
    Shell.NavBarIsVisible="False">

    <Grid>
        <!-- Keep modal and busy layers outside the content they disable. -->
        <Grid x:Name="PageContent" RowDefinitions="Auto,*" RowSpacing="10" IsEnabled="{Binding IsScoringContentEnabled}">

<VerticalStackLayout Spacing="8">
                <header:AppPageHeader x:Name="PageHeader"
                Title="{x:Static res:AppResources.Scoring}"
                Variant="Subpage"
                BackClicked="OnBackClicked"
                GameName="{x:Static gameNav:ArkNovaGameSessionNavigationHandler.GameDisplayName}"
                BadgeText="{x:Static gameNav:ArkNovaGameSessionNavigationHandler.GameBadgeText}"
                Subtitle="{Binding GroupName}"
                Metadata="{Binding DateText}">
                <header:AppPageHeader.Actions>
                    <ImageButton WidthRequest="48" HeightRequest="48" IsVisible="{Binding IsLiveScoring}" Clicked="OnCameraClicked" Source="icon_camera.png" Style="{StaticResource HeaderIconButton}" />
                    <ImageButton WidthRequest="48" HeightRequest="48" IsVisible="{Binding IsLiveScoring}" Clicked="OnPhotoInfoClicked" Source="icon_info.png" Style="{StaticResource HeaderIconButton}"
                        SemanticProperties.Description="{x:Static res:AppResources.PhotoHelpTitle}" />
                    <ImageButton WidthRequest="48" HeightRequest="48" Clicked="OnSettingsClicked" Source="icon_settings.png" Style="{StaticResource HeaderIconButton}" />
                </header:AppPageHeader.Actions>
            </header:AppPageHeader>
            </VerticalStackLayout>
<Grid Grid.Row="1" Padding="14,0,14,14" RowDefinitions="*,Auto" RowSpacing="10">
<CollectionView Grid.Row="0" ItemsSource="{Binding Players}" SelectionMode="None" VerticalScrollBarVisibility="Never">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="7" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ArkNovaScoringPlayerViewModel">
                        <Border Padding="10,8" BackgroundColor="{Binding Tint}" Stroke="{DynamicResource Outline}" StrokeShape="RoundRectangle 10">
                            <Grid ColumnDefinitions="*,58" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="2">
                                <Grid Grid.RowSpan="4" ColumnDefinitions="*,Auto" ColumnSpacing="6" MinimumHeightRequest="44">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPlayerTapped" CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="2">
                                        <Label TextColor="{Binding PlayerTextColor}" Text="{Binding NameWithScore}" FontAttributes="Bold" FontSize="16" />
                                        <Label Grid.Row="1" Text="{Binding Subtitle}" FontSize="12" FontAttributes="Bold" TextColor="{Binding PlayerTextColor}" />
                                        <Label TextColor="{Binding PlayerTextColor}" Grid.Row="2" Text="{Binding RawValuesText}" FontSize="12" />
                                        <Label Grid.Row="3" Text="{Binding SecondaryValuesText}" FontSize="12" TextColor="{Binding PlayerTextColor}" />
                                    </Grid>
                                    <Image Grid.Column="1" Source="icon_chevron.png" Style="{StaticResource NavigationChevron}" presentation:IconTint.Color="{Binding PlayerTextColor}" />
                                </Grid>

                                <Grid Grid.Column="1" Grid.RowSpan="4"
                                      MinimumWidthRequest="52"
                                      MinimumHeightRequest="72"
                                      HorizontalOptions="End"
                                      VerticalOptions="Center"
                                      SemanticProperties.Description="{x:Static res:AppResources.SpecialCards}">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnAddSpecialCardTapped" CommandParameter="{Binding PlayerId}" />
                                    </Grid.GestureRecognizers>
                                    <Border Padding="0"
                                            BackgroundColor="Transparent"
                                            Stroke="{DynamicResource Outline}"
                                            StrokeShape="RoundRectangle 9"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill">
                                        <Image Source="icon_special_card.png"
                                               Aspect="AspectFit"
                                               WidthRequest="40" HeightRequest="52" InputTransparent="True" AutomationProperties.IsInAccessibleTree="False" />
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
<VerticalStackLayout Grid.Row="1" Spacing="6">
            <Label IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}" TextColor="{DynamicResource Danger}" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Button Style="{StaticResource DangerButton}" Text="{Binding DeleteText}"
                        MinimumHeightRequest="44"
                        Clicked="OnDiscardClicked" />
                <Button Grid.Column="1" Text="{Binding CompleteText}" Style="{StaticResource PrimaryCompactButton}" Clicked="OnCompleteClicked" IsEnabled="{Binding CanComplete}" />
            </Grid>

            </VerticalStackLayout>
</Grid>
</Grid>

        <Grid IsVisible="{Binding IsSpecialCardPickerVisible}" IsEnabled="{Binding IsIdle}" BackgroundColor="{DynamicResource ModalOverlay}" Padding="18">
            <Border Style="{StaticResource SelectionDialog}">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <ImageButton Source="icon_back.png" Clicked="OnSpecialCardPickerBackClicked" Style="{StaticResource IconButton}"
                                     SemanticProperties.Description="{x:Static res:AppResources.Back}"
                                     ToolTipProperties.Text="{x:Static res:AppResources.Back}" />
                        <Label Grid.Column="1" Text="{Binding SpecialCardPickerTitle}" FontAttributes="Bold" FontSize="20" VerticalOptions="Center" />
                    </Grid>
                    <CollectionView Grid.Row="1" ItemsSource="{Binding SpecialCardOptions}" BackgroundColor="{DynamicResource AppBackground}" SelectionMode="None" HeightRequest="330">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="7" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ArkNovaSpecialCardOptionViewModel">
                                <Border Padding="12,9" Stroke="{DynamicResource Outline}" StrokeShape="RoundRectangle 10" BackgroundColor="{DynamicResource Surface}"
                                        SemanticProperties.Description="{Binding StatusText}">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsAssignedToTarget}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource SelectedSurface}" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsAssignedToOtherPlayer}" Value="True">
                                            <Setter Property="Stroke" Value="{DynamicResource Danger}" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                            <Setter Property="StrokeDashArray" Value="4,3" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSpecialCardOptionTapped" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <ark:ArkNovaSpecialCardView Card="{Binding Card}" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>

        <Grid IsVisible="{Binding IsPhotoSourceVisible}" BackgroundColor="{DynamicResource ModalOverlay}" Padding="18">
            <Border Style="{StaticResource SelectionDialog}" IsEnabled="{Binding IsIdle}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <ImageButton Source="icon_back.png" Style="{StaticResource IconButton}" Clicked="OnPhotoSourceBackClicked"
                                     SemanticProperties.Description="{x:Static res:AppResources.Back}" />
                        <Label Grid.Column="1" Text="{x:Static res:AppResources.PhotoRecognition}" FontAttributes="Bold" FontSize="20" VerticalOptions="Center" />
                    </Grid>
                    <Button Text="{x:Static res:AppResources.PhotoTake}" Clicked="OnTakePhotoClicked" Style="{StaticResource PrimaryCompactButton}" />
                    <Button Text="{x:Static res:AppResources.PhotoChoose}" Clicked="OnChoosePhotoClicked" Style="{StaticResource SecondaryActionButton}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
        <Grid IsVisible="{Binding IsPhotoReviewVisible}" BackgroundColor="{DynamicResource ModalOverlay}" Padding="18">
            <Border Style="{StaticResource SelectionDialog}" IsEnabled="{Binding IsIdle}">
                <VerticalStackLayout Spacing="10">
                    <header:AppPageHeader Title="{x:Static res:AppResources.PhotoReviewTitle}" BackClicked="OnCancelPhotoClicked"
                        GameName="{x:Static gameNav:ArkNovaGameSessionNavigationHandler.GameDisplayName}"
                        BadgeText="{x:Static gameNav:ArkNovaGameSessionNavigationHandler.GameBadgeText}">
                        <header:AppPageHeader.Actions>
                            <ImageButton Source="icon_info.png" Style="{StaticResource HeaderIconButton}" WidthRequest="48" HeightRequest="48" Clicked="OnPhotoReviewInfoClicked" SemanticProperties.Description="{x:Static res:AppResources.PhotoReviewTitle}" />
                        </header:AppPageHeader.Actions>
                    </header:AppPageHeader>
                    <CollectionView ItemsSource="{Binding PhotoPlayers}" HeightRequest="350" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ArkNovaPhotoReviewPlayer">
                                <Border Style="{StaticResource CardBorder}" Padding="10" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="Auto,*,80" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" />
                                        <Label Grid.Row="1" Text="{x:Static res:AppResources.Attractiveness}" VerticalOptions="Center" />
                                        <Entry Grid.Row="1" Grid.Column="2" Text="{Binding AttractivenessText}" Keyboard="Numeric" MaxLength="3" />
                                        <Label Grid.Row="1" Grid.Column="1" VerticalOptions="Center" Text="{Binding AttractivenessStatus}" FontSize="12" TextColor="{DynamicResource Danger}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding AttractivenessConfidence}" Value="High"><Setter Property="TextColor" Value="{DynamicResource RecognitionHigh}" /></DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding AttractivenessConfidence}" Value="Medium"><Setter Property="TextColor" Value="{DynamicResource RecognitionMedium}" /></DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Grid.Row="2" Text="{x:Static res:AppResources.Conservation}" VerticalOptions="Center" />
                                        <Entry Grid.Row="2" Grid.Column="2" Text="{Binding ConservationText}" Keyboard="Numeric" MaxLength="2" />
                                        <Label Grid.Row="2" Grid.Column="1" VerticalOptions="Center" Text="{Binding ConservationStatus}" FontSize="12" TextColor="{DynamicResource Danger}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding ConservationConfidence}" Value="High"><Setter Property="TextColor" Value="{DynamicResource RecognitionHigh}" /></DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding ConservationConfidence}" Value="Medium"><Setter Property="TextColor" Value="{DynamicResource RecognitionMedium}" /></DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Grid.Row="3" IsVisible="{Binding ShowReputation}" Text="{x:Static res:AppResources.Reputation}" VerticalOptions="Center" />
                                        <Entry Grid.Row="3" Grid.Column="2" IsVisible="{Binding ShowReputation}" Text="{Binding ReputationText}" Keyboard="Numeric" MaxLength="2" />
                                        <Label Grid.Row="3" Grid.Column="1" VerticalOptions="Center" IsVisible="{Binding ShowReputation}" Text="{Binding ReputationStatus}" FontSize="12" TextColor="{DynamicResource Danger}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding ReputationConfidence}" Value="High"><Setter Property="TextColor" Value="{DynamicResource RecognitionHigh}" /></DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding ReputationConfidence}" Value="Medium"><Setter Property="TextColor" Value="{DynamicResource RecognitionMedium}" /></DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Label Text="{Binding PhotoError}" TextColor="{DynamicResource Danger}" FontSize="12" />
                    <Button Text="{x:Static res:AppResources.PhotoConfirm}" Clicked="OnConfirmPhotoClicked" Style="{StaticResource PrimaryCompactButton}" />
                </VerticalStackLayout>
            </Border>
        </Grid>
        <Grid IsVisible="{Binding IsBusy}" BackgroundColor="{DynamicResource BusyOverlay}">
            <ActivityIndicator Color="{DynamicResource BusyIndicator}" IsRunning="True" HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
