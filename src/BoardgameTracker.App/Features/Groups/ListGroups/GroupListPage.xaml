<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:BoardgameTracker.App.Features.Groups.ListGroups" xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization"
    x:Class="BoardgameTracker.App.Features.Groups.ListGroups.GroupListPage" x:DataType="local:GroupListViewModel" Shell.NavBarIsVisible="False">
    <Grid>
        <Grid Padding="18" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="12" IsEnabled="{Binding CanInteract}">
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <ImageButton Source="icon_back.png" Style="{StaticResource IconButton}" Clicked="OnBackClicked" SemanticProperties.Description="{x:Static res:AppResources.Back}" />
                    <Label Grid.Column="1" Text="{x:Static res:AppResources.Groups}" FontSize="24" FontAttributes="Bold" VerticalOptions="Center" />
                </Grid>
                <Border BackgroundColor="Transparent" Stroke="{DynamicResource GameContextBorder}" StrokeThickness="1" StrokeShape="RoundRectangle 14" HeightRequest="28" Padding="12,0" HorizontalOptions="Start" SemanticProperties.Description="{Binding SelectedGameName}">
                    <Label Text="{Binding BadgeText}" FontSize="13" TextColor="{DynamicResource GameContextText}" VerticalOptions="Center" />
                </Border>
                <BoxView Style="{StaticResource HeaderDivider}" />
            </VerticalStackLayout>
            <CollectionView Grid.Row="1" ItemsSource="{Binding Groups}" SelectionMode="None">
                <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="8" /></CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:GroupListItemViewModel">
                        <Border Style="{StaticResource CardBorder}" Padding="12">
                            <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnGroupTapped" CommandParameter="{Binding Id}" /></Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="4">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                                    <Image Source="icon_active_session.png" HeightRequest="20" WidthRequest="20" IsVisible="{Binding HasOpenGameSession}" SemanticProperties.Description="{x:Static res:AppResources.OpenGameSession}" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding PlayerNames}" />
                                <Label Text="{Binding LastPlayedText}" IsVisible="{Binding HasLastPlayed}" FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <VerticalStackLayout Grid.Row="2" Spacing="8">
                <Label Text="{Binding EmptyMessage}" IsVisible="{Binding IsEmpty}" />
                <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{DynamicResource Danger}" />
            </VerticalStackLayout>
            <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="{x:Static res:AppResources.NewGroup}" Clicked="OnCreateGroupClicked" IsEnabled="{Binding CanCreate}" Style="{StaticResource SecondaryActionButton}" />
                <Button Grid.Column="1" Text="{x:Static res:AppResources.ChooseExistingGroup}" Clicked="OnChooseExistingClicked" IsEnabled="{Binding CanChoose}" Style="{StaticResource PrimaryCompactButton}" />
            </Grid>
        </Grid>
        <Grid IsVisible="{Binding IsChoosingExisting}" BackgroundColor="{DynamicResource ModalOverlay}" Padding="18">
            <Border Style="{StaticResource SelectionDialog}">
                <Grid RowDefinitions="Auto,*" RowSpacing="12" MaximumHeightRequest="450">
                    <Grid ColumnDefinitions="Auto,*">
                        <ImageButton Source="icon_back.png" Style="{StaticResource IconButton}" Clicked="OnCloseSelectionClicked" SemanticProperties.Description="{x:Static res:AppResources.Back}" />
                        <Label Grid.Column="1" Text="{x:Static res:AppResources.ChooseExistingGroup}" FontSize="19" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <CollectionView Grid.Row="1" ItemsSource="{Binding AvailableGroups}" SelectionMode="None">
                        <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="8" /></CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="local:AvailablePlayGroup">
                                <Border Style="{StaticResource CardBorder}" Padding="12">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnExistingTapped" CommandParameter="{Binding .}" /></Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4"><Label Text="{Binding Name}" FontAttributes="Bold" /><Label Text="{Binding Members}" /></VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>
        <Grid IsVisible="{Binding IsWorking}" BackgroundColor="{DynamicResource BusyOverlay}"><ActivityIndicator IsRunning="{Binding IsWorking}" Color="{DynamicResource BusyIndicator}" HorizontalOptions="Center" VerticalOptions="Center" /></Grid>
    </Grid>
</ContentPage>
