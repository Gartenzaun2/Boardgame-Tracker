<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BoardgameTracker.App.Features.Groups.CreateGroup.CreateGroupPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:application="clr-namespace:BoardgameTracker.Application.Groups;assembly=BoardgameTracker.Application"
    xmlns:models="clr-namespace:BoardgameTracker.App.Features.Groups"
    xmlns:local="clr-namespace:BoardgameTracker.App.Features.Groups.CreateGroup"
    xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization"
    x:DataType="local:CreateGroupViewModel"
    Shell.NavBarIsVisible="False">

    <Grid>
        <!-- Keep modal and busy layers outside the content they disable. -->
        <Grid x:Name="PageContent" RowDefinitions="Auto,Auto,*" IsEnabled="False">
            <Grid.Triggers>
                <MultiTrigger TargetType="Grid">
                    <MultiTrigger.Conditions>
                        <BindingCondition Binding="{Binding IsBusy}" Value="False" />
                        <BindingCondition Binding="{Binding IsAddingNewPlayer}" Value="False" />
                        <BindingCondition Binding="{Binding IsChoosingGame}" Value="False" />
                        <BindingCondition Binding="{Binding IsVisible, Source={x:Reference ExistingPlayerOverlay}, x:DataType=Grid}" Value="False" />
                    </MultiTrigger.Conditions>
                    <Setter Property="IsEnabled" Value="True" />
                </MultiTrigger>
            </Grid.Triggers>
            <Grid
                Padding="8,8,12,8"
                ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="4">
                <ImageButton
                    Clicked="OnBackClicked"
                    Source="icon_back.png"
                    Style="{StaticResource IconButton}"
                    SemanticProperties.Description="{x:Static res:AppResources.Back}"
                    ToolTipProperties.Text="{x:Static res:AppResources.Back}" />

                <HorizontalStackLayout
                    Grid.Column="1"
                    Spacing="2"
                    VerticalOptions="Center">
                    <Label
                        FontAttributes="Bold"
                        FontSize="21"
                        Text="{x:Static res:AppResources.CreateGroup}"
                        VerticalOptions="Center" />
                    <ImageButton
                        Clicked="OnInfoClicked"
                        Source="icon_info.png"
                        Style="{StaticResource IconButton}"
                        SemanticProperties.Description="{x:Static res:AppResources.CreateGroupHint}"
                        ToolTipProperties.Text="{x:Static res:AppResources.CreateGroupHint}" />
                </HorizontalStackLayout>

                <Button
                    Grid.Column="2"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryCompactButton}"
                    Text="{x:Static res:AppResources.Save}"
                    VerticalOptions="Center" />
            </Grid>

            <BoxView Grid.Row="1" Style="{StaticResource HeaderDivider}" />
            <ScrollView Grid.Row="2">
                <VerticalStackLayout Padding="20,12,20,28" Spacing="20">
                    <VerticalStackLayout Spacing="16">
                        <Label FontAttributes="Bold" FontSize="18" Text="{x:Static res:AppResources.GroupName}" />
                        <Entry Style="{StaticResource InlineFormEntry}" Placeholder="{x:Static res:AppResources.GroupNameExample}" Text="{Binding GroupName}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="2">
                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="{x:Static res:AppResources.GroupPlayers}"
                                VerticalOptions="Center" />
                            <ImageButton
                                Clicked="OnPlayersInfoClicked"
                                Source="icon_info.png"
                                Style="{StaticResource IconButton}"
                                SemanticProperties.Description="{x:Static res:AppResources.DefaultOrderHint}"
                                ToolTipProperties.Text="{x:Static res:AppResources.DefaultOrderHint}" />
                        </HorizontalStackLayout>

                        <Label
                            IsVisible="{Binding HasNoPlayers}"
                            Text="{x:Static res:AppResources.NoPlayersYet}"
                            TextColor="{DynamicResource TextPrimary}" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Players}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:GroupMemberDraft">
                                    <Border Margin="0,4" Padding="12" Style="{StaticResource CardBorder}">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                            <VerticalStackLayout Spacing="2">
                                                <HorizontalStackLayout Spacing="8"><Label FontAttributes="Bold" Text="{Binding Position}" /><Label FontAttributes="Bold" Text="{Binding Name}" /></HorizontalStackLayout>
                                                <Label
                                                    FontSize="12"
                                                    IsVisible="{Binding IsGuest}"
                                                    Text="{x:Static res:AppResources.Guest}" />
                                            </VerticalStackLayout>
                                            <Button Style="{StaticResource TextActionButton}" MinimumWidthRequest="48" MinimumHeightRequest="48" FontSize="26" Grid.Column="1" Command="{Binding Source={x:Reference Page}, Path=ViewModel.MovePlayerUpCommand, x:DataType=local:CreateGroupPage}" CommandParameter="{Binding .}" IsEnabled="{Binding CanMoveUp}" SemanticProperties.Description="{x:Static res:AppResources.MoveUp}" Text="↑" />
                                            <Button Style="{StaticResource TextActionButton}" MinimumWidthRequest="48" MinimumHeightRequest="48" FontSize="26" Grid.Column="2" Command="{Binding Source={x:Reference Page}, Path=ViewModel.MovePlayerDownCommand, x:DataType=local:CreateGroupPage}" CommandParameter="{Binding .}" IsEnabled="{Binding CanMoveDown}" SemanticProperties.Description="{x:Static res:AppResources.MoveDown}" Text="↓" />
                                            <Button Style="{StaticResource TextActionButton}" MinimumWidthRequest="48" MinimumHeightRequest="48" FontSize="26" TextColor="{DynamicResource Danger}" Grid.Column="3" Command="{Binding Source={x:Reference Page}, Path=ViewModel.RemovePlayerCommand, x:DataType=local:CreateGroupPage}" CommandParameter="{Binding .}" SemanticProperties.Description="{x:Static res:AppResources.Remove}" Text="×" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button Text="{x:Static res:AppResources.AddExistingPlayerAction}" Style="{StaticResource SecondaryActionButton}" Clicked="OnChooseExistingPlayerClicked" IsEnabled="{Binding HasAvailablePlayers}" />
                        <Button Grid.Column="1" Text="{x:Static res:AppResources.NewPlayerTitle}" Style="{StaticResource SecondaryActionButton}" Clicked="OnNewPlayerClicked" />
                    </Grid>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="{x:Static res:AppResources.GamesSection}" FontAttributes="Bold" FontSize="18" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedGames}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:GroupGameSelection">
                                    <Border Style="{StaticResource CardBorder}" Margin="0,4" Padding="12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <VerticalStackLayout VerticalOptions="Center">
                                                <Label Text="{Binding Name}" FontAttributes="Bold" />
                                                <Label Text="{Binding LockReason}" IsVisible="{Binding IsLocked}" FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1" Text="×" FontSize="26" Style="{StaticResource TextActionButton}" TextColor="{DynamicResource Danger}" IsEnabled="{Binding CanChange}" Command="{Binding Source={x:Reference Page}, Path=ViewModel.RemoveGameCommand, x:DataType=local:CreateGroupPage}" CommandParameter="{Binding .}" SemanticProperties.Description="{x:Static res:AppResources.Remove}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Button Text="{x:Static res:AppResources.AddGame}" Style="{StaticResource SecondaryActionButton}" Clicked="OnChooseGameClicked" IsEnabled="{Binding HasAvailableGames}" HorizontalOptions="Start" />
                    </VerticalStackLayout>

                    <Label IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}" TextColor="{DynamicResource Danger}" />
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <Grid x:Name="ExistingPlayerOverlay" IsVisible="False" BackgroundColor="{DynamicResource ModalOverlay}" Padding="18">
            <Grid.Triggers>
                <DataTrigger TargetType="Grid" Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Grid.Triggers>
            <Border Style="{StaticResource SelectionDialog}">
                <Grid RowDefinitions="Auto,*" RowSpacing="12" MaximumHeightRequest="400">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <ImageButton Source="icon_back.png" Style="{StaticResource IconButton}" Clicked="OnCloseExistingPlayerClicked"
                                     SemanticProperties.Description="{x:Static res:AppResources.Back}"
                                     ToolTipProperties.Text="{x:Static res:AppResources.Back}" />
                        <Label Grid.Column="1" Text="{x:Static res:AppResources.SelectExistingPlayerTitle}" FontAttributes="Bold" FontSize="19" VerticalOptions="Center" LineBreakMode="WordWrap" />
                    </Grid>
                    <CollectionView Grid.Row="1" ItemsSource="{Binding AvailablePlayers}" SelectionMode="None" HeightRequest="300" BackgroundColor="{DynamicResource AppBackground}">
                        <CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="7" /></CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="application:SelectablePlayer">
                                <Border Padding="12,9" Style="{StaticResource CardBorder}" MinimumHeightRequest="48" SemanticProperties.Description="{Binding Name}">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnExistingPlayerTapped" CommandParameter="{Binding .}" /></Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" />
                                        <Label Text="{x:Static res:AppResources.Guest}" IsVisible="{Binding IsGuest}" FontSize="12" TextColor="{DynamicResource TextSecondary}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>


        <Grid IsVisible="{Binding IsAddingNewPlayer}" BackgroundColor="{DynamicResource ModalOverlay}" Padding="18">
            <Border Style="{StaticResource SelectionDialog}" VerticalOptions="Center">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*">
                        <ImageButton Source="icon_back.png" Style="{StaticResource IconButton}" Clicked="OnCancelNewPlayerClicked" SemanticProperties.Description="{x:Static res:AppResources.Back}" />
                        <Label Grid.Column="1" Text="{x:Static res:AppResources.NewPlayerTitle}" FontSize="19" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="{x:Static res:AppResources.PlayerNameLabel}" />
                    <Entry Text="{Binding NewPlayerName}" Style="{StaticResource InlineFormEntry}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{x:Static res:AppResources.Guest}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding NewPlayerIsGuest}" />
                    </Grid>
                    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="{DynamicResource Danger}" />
                    <Button Text="{x:Static res:AppResources.AddToDraft}" Command="{Binding AddNewPlayerCommand}" Style="{StaticResource PrimaryCompactButton}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Grid IsVisible="{Binding IsChoosingGame}" BackgroundColor="{DynamicResource ModalOverlay}" Padding="18">
            <Border Style="{StaticResource SelectionDialog}">
                <Grid RowDefinitions="Auto,*" RowSpacing="12" MaximumHeightRequest="400">
                    <Grid ColumnDefinitions="Auto,*">
                        <ImageButton Source="icon_back.png" Style="{StaticResource IconButton}" Clicked="OnCloseGameClicked" SemanticProperties.Description="{x:Static res:AppResources.Back}" />
                        <Label Grid.Column="1" Text="{x:Static res:AppResources.AddGame}" FontSize="19" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <CollectionView Grid.Row="1" ItemsSource="{Binding AvailableGames}" SelectionMode="None" HeightRequest="300">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:GroupGameSelection">
                                <Border Padding="12" Margin="0,4" Style="{StaticResource CardBorder}">
                                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnGameTapped" CommandParameter="{Binding .}" /></Border.GestureRecognizers>
                                    <Label Text="{Binding Name}" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
        </Grid>

        <Grid
            BackgroundColor="{DynamicResource BusyOverlay}"
            InputTransparent="False"
            IsVisible="{Binding IsBusy}">
            <ActivityIndicator Color="{DynamicResource BusyIndicator}"
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                VerticalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>
