<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="BoardgameTracker.App.Features.GameSessions.Scoring.ArkNovaScoringPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res="clr-namespace:BoardgameTracker.App.Resources.Localization"
    Shell.NavBarIsVisible="False">

    <Grid Padding="18" RowDefinitions="Auto,*" RowSpacing="20">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <ImageButton
                Clicked="OnBackClicked"
                Source="icon_back.png"
                Style="{StaticResource IconButton}"
                SemanticProperties.Description="{x:Static res:AppResources.Back}" />
            <Label
                Grid.Column="1"
                FontAttributes="Bold"
                FontSize="23"
                Text="{x:Static res:AppResources.Scoring}"
                VerticalOptions="Center" />
        </Grid>
        <Border Grid.Row="1" Padding="16" Style="{StaticResource CardBorder}" VerticalOptions="Start">
            <Label
                Text="{x:Static res:AppResources.ScoringPlaceholder}"
                TextColor="{StaticResource TextSecondary}" />
        </Border>
    </Grid>
</ContentPage>
